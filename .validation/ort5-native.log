2026-11-13T09:32:49.0829562Z                 self.assertEqual(list(source), before)
2026-11-13T09:32:49.0829798Z                 result[0] ^= 0xFF
2026-11-13T09:32:49.0830185Z                 self.assertEqual(list(source), before)
