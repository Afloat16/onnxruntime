2026-11-13T09:32:49.0822586Z             with self.subTest(factory=factory.__name__):
2026-11-13T09:32:49.0822838Z                 storage = bytearray([0, 1, 2, 15, 8])
2026-11-13T09:32:49.0823268Z                 source = factory(storage)
