2026-11-13T09:32:49.0818959Z                 self.assertEqual(actual, pack_reference(values))
2026-11-13T09:32:49.0819150Z 
2026-11-13T09:32:49.0819239Z     def test_lengths_and_odd_padding(self):
2026-11-13T09:32:49.0819530Z         for length in (0, 1, 2, 3, 15, 16, 17, 255, 256, 257, 65535, 65536, 65537):
2026-11-13T09:32:49.0819825Z             with self.subTest(length=length):
2026-11-13T09:32:49.0820143Z                 values = ((np.arange(length, dtype=np.int64) * 7) % 16).astype(np.uint8)
2026-11-13T09:32:49.0820473Z                 actual = pack_bytes_to_4bit(values.tobytes())
2026-11-13T09:32:49.0820759Z                 self.assertEqual(actual, pack_reference(values))
2026-11-13T09:32:49.0821040Z                 self.assertEqual(len(actual), (length + 1) // 2)
2026-11-13T09:32:49.0821290Z                 if length % 2:
2026-11-13T09:32:49.0821515Z                     self.assertEqual(actual[-1] >> 4, 0)
2026-11-13T09:32:49.0821679Z 
2026-11-13T09:32:49.0821789Z     def test_source_ownership_and_buffer_inputs(self):
