2026-11-13T09:32:49.0836939Z                     restored.ParseFromString(quantized.SerializeToString())
2026-11-13T09:32:49.0837566Z                     np.testing.assert_array_equal(numpy_helper.to_array(restored).astype(np.int16), expected)
