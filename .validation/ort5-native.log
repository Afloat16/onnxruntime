2026-11-13T09:32:49.0816962Z                 values = np.array(
2026-11-13T09:32:49.0817483Z                     [number for first in numbers for second in numbers for number in (first, second)],
2026-11-13T09:32:49.0817864Z                     dtype=np.int8 if signed else np.uint8,
2026-11-13T09:32:49.0818165Z                 )
2026-11-13T09:32:49.0818381Z                 actual = pack_bytes_to_4bit(values.tobytes())
