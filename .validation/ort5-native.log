2026-11-13T09:32:49.0825329Z     def test_noncontiguous_and_nonbyte_sequences_keep_element_order(self):
2026-11-13T09:32:49.0825631Z         sources = {
2026-11-13T09:32:49.0825899Z             "strided_view": memoryview(bytearray([0, 9, 1, 9, 2]))[::2],
2026-11-13T09:32:49.0826235Z             "reversed_view": memoryview(bytearray([8, 15, 2, 1, 0]))[::-1],
2026-11-13T09:32:49.0826608Z             "signed_view": memoryview(np.array([-8, -1, 0, 7, -2], dtype=np.int8)),
2026-11-13T09:32:49.0826991Z             "wider_view": memoryview(np.array([-8, -1, 0, 7, -2], dtype=np.int16)),
2026-11-13T09:32:49.0827295Z             "list": [0, 1, 2, 15, 8],
2026-11-13T09:32:49.0827578Z             "strided_array": np.array([0, 9, 1, 9, 2], dtype=np.uint8)[::2],
2026-11-13T09:32:49.0827856Z         }
2026-11-13T09:32:49.0828042Z         for name, source in sources.items():
2026-11-13T09:32:49.0828281Z             with self.subTest(source=name):
2026-11-13T09:32:49.0828511Z                 before = list(source)
2026-11-13T09:32:49.0828741Z                 result = pack_bytes_to_4bit(source)
2026-11-13T09:32:49.0829009Z                 self.assertEqual(result, pack_reference(source))
