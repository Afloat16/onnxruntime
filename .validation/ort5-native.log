2026-11-13T09:32:49.0813538Z def pack_reference(values):
2026-11-13T09:32:49.0813750Z     result = bytearray()
2026-11-13T09:32:49.0813968Z     for start in range(0, len(values), 2):
2026-11-13T09:32:49.0814211Z         low = int(values[start]) % 16
2026-11-13T09:32:49.0814498Z         high = int(values[start + 1]) % 16 if start + 1 < len(values) else 0
2026-11-13T09:32:49.0814799Z         result.append(low + 16 * high)
2026-11-13T09:32:49.0815021Z     return result
