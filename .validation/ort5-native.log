2026-11-13T09:32:49.0823790Z                 self.assertEqual(result, expected)
2026-11-13T09:32:49.0824081Z                 self.assertEqual(storage, bytearray([0, 1, 2, 15, 8]))
2026-11-13T09:32:49.0824356Z                 result[0] = 255
2026-11-13T09:32:49.0824576Z                 self.assertEqual(storage[0], 0)
2026-11-13T09:32:49.0824812Z                 storage[-1] = 0
2026-11-13T09:32:49.0825019Z                 self.assertEqual(result[-1], 8)
