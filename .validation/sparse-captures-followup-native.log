2026-11-13T10:21:49.4793066Z     def remove_unused_constant(self):
2026-11-13T10:21:49.4793755Z         input_names = {name for node in self.nodes() for name in _get_node_input_names(node)}
2026-11-13T10:21:49.4794333Z 
2026-11-13T10:21:49.4794483Z         # remove unused constant
2026-11-13T10:21:49.4794910Z         unused_nodes = []
2026-11-13T10:21:49.4795288Z         nodes = self.nodes()
2026-11-13T10:21:49.4795673Z         for node in nodes:
2026-11-13T10:21:49.4796027Z             if (
2026-11-13T10:21:49.4796368Z                 node.op_type == "Constant"
2026-11-13T10:21:49.4796887Z                 and not self.is_graph_output(node.output[0])
2026-11-13T10:21:49.4797456Z                 and node.output[0] not in input_names
2026-11-13T10:21:49.4797915Z             ):
2026-11-13T10:21:49.4798251Z                 unused_nodes.append(node)
2026-11-13T10:21:49.4798574Z 
2026-11-13T10:21:49.4798732Z         self.remove_nodes(unused_nodes)
2026-11-13T10:21:49.4799252Z 
2026-11-13T10:21:49.4799405Z         ununsed_weights = []
2026-11-13T10:21:49.4799813Z         for w in self.initializer():
2026-11-13T10:21:49.4800580Z             if w.name not in input_names and not self.is_graph_output(w.name):
2026-11-13T10:21:49.4801220Z                 ununsed_weights.append(w)
2026-11-13T10:21:49.4801687Z                 # Remove from graph.input
2026-11-13T10:21:49.4802175Z                 for graph_input in self.graph().input:
2026-11-13T10:21:49.4802694Z                     if graph_input.name == w.name:
2026-11-13T10:21:49.4803227Z                         self.graph().input.remove(graph_input)
2026-11-13T10:21:49.4803604Z 
2026-11-13T10:21:49.4803793Z         self.remove_initializers(ununsed_weights)
2026-11-13T10:21:49.4804151Z 
2026-11-13T10:21:49.4804320Z     def is_graph_output(self, output_name):
2026-11-13T10:21:49.4805004Z         return any(output.name == output_name for output in self.model.graph.output)
2026-11-13T10:21:49.4805556Z 
2026-11-13T10:21:49.4805780Z     def is_graph_input(self, tensor_name: str) -> bool:
2026-11-13T10:21:49.4806490Z         return any(input.name == tensor_name for input in self.model.graph.input)
2026-11-13T10:21:49.4807015Z 
2026-11-13T10:21:49.4807475Z     # TODO:use OnnxModel.graph_topological_sort(self.model.graph) from transformers.onnx_model
2026-11-13T10:21:49.4808522Z     # Currently it breaks Openvino/Linux training gpu pipeline so hold off for 1.8 release
2026-11-13T10:21:49.4809482Z     def topological_sort(self):
2026-11-13T10:21:49.4810056Z         deps_count = [0] * len(self.nodes())  # dependency count of each node
2026-11-13T10:21:49.4810719Z         deps_to_nodes = {}  # input to node indice
2026-11-13T10:21:49.4811253Z         sorted_nodes = []  # initialize sorted_nodes
2026-11-13T10:21:49.4811804Z         for node_idx, node in enumerate(self.nodes()):
2026-11-13T10:21:49.4812481Z             # CANNOT use len(node.input) directly because input can be optional
2026-11-13T10:21:49.4813153Z             input_names = _get_node_input_names(node)
2026-11-13T10:21:49.4813680Z             deps_count[node_idx] = len(input_names)
2026-11-13T10:21:49.4814349Z             if deps_count[node_idx] == 0:  # Constant doesn't depend on any inputs
2026-11-13T10:21:49.4815051Z                 sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T10:21:49.4815552Z                 continue
2026-11-13T10:21:49.4815782Z 
2026-11-13T10:21:49.4815949Z             for input_name in input_names:
2026-11-13T10:21:49.4816434Z                 if input_name not in deps_to_nodes:
2026-11-13T10:21:49.4816976Z                     deps_to_nodes[input_name] = [node_idx]
2026-11-13T10:21:49.4817455Z                 else:
2026-11-13T10:21:49.4817872Z                     deps_to_nodes[input_name].append(node_idx)
2026-11-13T10:21:49.4818360Z 
2026-11-13T10:21:49.4818658Z         initializer_names = [init.name for init in self.initializer()]
2026-11-13T10:21:49.4819928Z         initializer_names.extend(init.values.name for init in self.graph().sparse_initializer)
2026-11-13T10:21:49.4820885Z         graph_input_names = [input.name for input in self.model.graph.input]
2026-11-13T10:21:49.4821616Z         input_names = initializer_names + graph_input_names
2026-11-13T10:21:49.4822144Z         input_names.sort()
2026-11-13T10:21:49.4822533Z         prev_input_name = None
2026-11-13T10:21:49.4822947Z         for input_name in input_names:
2026-11-13T10:21:49.4823418Z             if prev_input_name == input_name:
2026-11-13T10:21:49.4823875Z                 continue
2026-11-13T10:21:49.4824096Z 
2026-11-13T10:21:49.4824275Z             prev_input_name = input_name
2026-11-13T10:21:49.4824738Z             if input_name in deps_to_nodes:
2026-11-13T10:21:49.4825248Z                 for node_idx in deps_to_nodes[input_name]:
2026-11-13T10:21:49.4825839Z                     deps_count[node_idx] = deps_count[node_idx] - 1
2026-11-13T10:21:49.4826411Z                     if deps_count[node_idx] == 0:
2026-11-13T10:21:49.4826955Z                         sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T10:21:49.4827350Z 
2026-11-13T10:21:49.4827474Z         start = 0
2026-11-13T10:21:49.4827816Z         end = len(sorted_nodes)
2026-11-13T10:21:49.4828237Z 
2026-11-13T10:21:49.4828386Z         while start < end:
2026-11-13T10:21:49.4828809Z             for output in sorted_nodes[start].output:
2026-11-13T10:21:49.4829525Z                 if output in deps_to_nodes:
2026-11-13T10:21:49.4830026Z                     for node_idx in deps_to_nodes[output]:
2026-11-13T10:21:49.4830619Z                         deps_count[node_idx] = deps_count[node_idx] - 1
2026-11-13T10:21:49.4831200Z                         if deps_count[node_idx] == 0:
2026-11-13T10:21:49.4831764Z                             sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T10:21:49.4832304Z                             end = end + 1
2026-11-13T10:21:49.4832748Z             start = start + 1
2026-11-13T10:21:49.4833008Z 
2026-11-13T10:21:49.4833265Z         assert end == len(self.graph().node), "Graph is not a DAG"
2026-11-13T10:21:49.4833843Z         self.graph().ClearField("node")
2026-11-13T10:21:49.4834314Z         self.graph().node.extend(sorted_nodes)
2026-11-13T10:21:49.4834662Z 
2026-11-13T10:21:49.4834819Z     def clean_initializers(self):
2026-11-13T10:21:49.4835365Z         return _clean_initializers_helper(self.graph(), self.model)
2026-11-13T10:21:49.4835814Z 
2026-11-13T10:21:49.4835984Z     def _check_init(self, init, test=None):
2026-11-13T10:21:49.4836541Z         if init.data_type == onnx.TensorProto.FLOAT8E4M3FN:
2026-11-13T10:21:49.4837108Z             if init.HasField("raw_data"):
2026-11-13T10:21:49.4837561Z                 b = list(init.raw_data)
2026-11-13T10:21:49.4838017Z                 if any((i & 127) == 127 for i in b):
2026-11-13T10:21:49.4838611Z                     raise ValueError(f"Initializer {init.name!r} has nan.")
2026-11-13T10:21:49.4839403Z         return init
2026-11-13T10:21:49.4839612Z 
2026-11-13T10:21:49.4839761Z     def _check_node(self, node):
2026-11-13T10:21:49.4840150Z         """
2026-11-13T10:21:49.4840655Z         A quantization to float 8 does not use quantized bias but float 16 bias.
2026-11-13T10:21:49.4841440Z         This function checks that DequantizeLinear is not used to
2026-11-13T10:21:49.4842029Z         dequantize from float 16.
2026-11-13T10:21:49.4842427Z         """
2026-11-13T10:21:49.4842774Z         if node.op_type == "DequantizeLinear":
2026-11-13T10:21:49.4843266Z             zero_point = node.input[2]
2026-11-13T10:21:49.4843748Z             init = self.get_initializer(zero_point)
2026-11-13T10:21:49.4844256Z             dtype = init.data_type
2026-11-13T10:21:49.4844666Z             if dtype in {
2026-11-13T10:21:49.4845056Z                 onnx.TensorProto.FLOAT16,
2026-11-13T10:21:49.4845525Z                 onnx.TensorProto.FLOAT,
2026-11-13T10:21:49.4845984Z                 onnx.TensorProto.DOUBLE,
2026-11-13T10:21:49.4846626Z                 onnx.TensorProto.BFLOAT16,
2026-11-13T10:21:49.4847059Z             }:
2026-11-13T10:21:49.4847744Z                 raise RuntimeError(f"Unsupported DequantizeLinear operator, dequantization from {dtype}.")
2026-11-13T10:21:49.4848546Z         return node
2026-11-13T10:21:49.4848750Z 
