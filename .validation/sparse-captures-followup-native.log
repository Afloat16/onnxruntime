2026-11-13T10:21:49.4922080Z             [choice],
2026-11-13T10:21:49.4922214Z             [scalar_info("condition", TensorProto.BOOL)],
2026-11-13T10:21:49.4922311Z             [float_info("output")],
2026-11-13T10:21:49.4922524Z             [numpy_helper.from_array(np.array([99.0, 99.0], dtype=np.float32), "local")],
