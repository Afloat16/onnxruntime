2026-11-13T10:21:49.4756780Z     def replace_gemm_with_matmul(self):
2026-11-13T10:21:49.4757234Z         tensor_names = set()
2026-11-13T10:21:49.4757626Z         graphs = [self.graph()]
2026-11-13T10:21:49.4758015Z         while graphs:
2026-11-13T10:21:49.4758370Z             graph = graphs.pop()
2026-11-13T10:21:49.4759309Z             tensor_names.update(tensor.name for tensor in graph.initializer)
2026-11-13T10:21:49.4760297Z             tensor_names.update(value.name for value in (*graph.input, *graph.output, *graph.value_info))
2026-11-13T10:21:49.4761106Z             for node in graph.node:
2026-11-13T10:21:49.4761561Z                 tensor_names.update(node.input)
2026-11-13T10:21:49.4762070Z                 tensor_names.update(node.output)
2026-11-13T10:21:49.4762561Z                 for attr in node.attribute:
2026-11-13T10:21:49.4763280Z                     if attr.type == onnx.AttributeProto.GRAPH:
2026-11-13T10:21:49.4763830Z                         graphs.append(attr.g)
2026-11-13T10:21:49.4764382Z                     elif attr.type == onnx.AttributeProto.GRAPHS:
2026-11-13T10:21:49.4764969Z                         graphs.extend(attr.graphs)
2026-11-13T10:21:49.4765454Z         graph_path = [self.graph()]
2026-11-13T10:21:49.4765879Z         transposed_sources = {}
2026-11-13T10:21:49.4766547Z         ONNXModel.__replace_gemm_with_matmul(graph_path, tensor_names, transposed_sources)
2026-11-13T10:21:49.4767286Z         return transposed_sources
2026-11-13T10:21:49.4767567Z 
2026-11-13T10:21:49.4767906Z     def save_model_to_file(self, output_path, use_external_data_format=False):
2026-11-13T10:21:49.4768537Z         """
2026-11-13T10:21:49.4769190Z         Save model to external data, which is needed for model size > 2GB
2026-11-13T10:21:49.4769785Z         """
2026-11-13T10:21:49.4770113Z         self.topological_sort()
2026-11-13T10:21:49.4770600Z         if use_external_data_format:
2026-11-13T10:21:49.4771157Z             onnx.external_data_helper.convert_model_to_external_data(
2026-11-13T10:21:49.4771733Z                 self.model,
2026-11-13T10:21:49.4772305Z                 all_tensors_to_one_file=True,
2026-11-13T10:21:49.4772832Z                 location=Path(output_path).name + ".data",
2026-11-13T10:21:49.4773350Z                 convert_attribute=True,
2026-11-13T10:21:49.4773765Z             )
2026-11-13T10:21:49.4774135Z         for init in self.model.graph.initializer:
2026-11-13T10:21:49.4774655Z             self._check_init(init, "end")
2026-11-13T10:21:49.4775140Z         onnx.save_model(self.model, output_path)
2026-11-13T10:21:49.4775481Z 
2026-11-13T10:21:49.4775616Z     @staticmethod
2026-11-13T10:21:49.4776081Z     def replace_node_input(node, old_input_name, new_input_name):
2026-11-13T10:21:49.4776877Z         assert isinstance(old_input_name, str) and isinstance(new_input_name, str)
2026-11-13T10:21:49.4777577Z         for j in range(len(node.input)):
2026-11-13T10:21:49.4778057Z             if node.input[j] == old_input_name:
