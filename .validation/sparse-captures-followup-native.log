2026-11-13T10:21:49.4853048Z 
2026-11-13T10:21:49.4853196Z import onnxruntime as ort
2026-11-13T10:21:49.4853707Z from onnxruntime.quantization.onnx_model import ONNXModel
2026-11-13T10:21:49.4854140Z 
2026-11-13T10:21:49.4854147Z 
2026-11-13T10:21:49.4854284Z def float_info(name):
2026-11-13T10:21:49.4854989Z     return helper.make_tensor_value_info(name, TensorProto.FLOAT, [2])
2026-11-13T10:21:49.4855484Z 
2026-11-13T10:21:49.4855490Z 
2026-11-13T10:21:49.4855648Z def scalar_info(name, dtype):
2026-11-13T10:21:49.4856143Z     return helper.make_tensor_value_info(name, dtype, [])
2026-11-13T10:21:49.4856541Z 
2026-11-13T10:21:49.4856547Z 
2026-11-13T10:21:49.4856794Z def make_model(nodes, inputs, outputs, initializers=()):
2026-11-13T10:21:49.4857612Z     graph = helper.make_graph(nodes, "captured_inputs", inputs, outputs, list(initializers))
2026-11-13T10:21:49.4858654Z     return helper.make_model(graph, opset_imports=[helper.make_opsetid("", 18)], ir_version=10)
2026-11-13T10:21:49.4859481Z 
2026-11-13T10:21:49.4859488Z 
2026-11-13T10:21:49.4859700Z def captured_branch(name, capture, negate=False):
2026-11-13T10:21:49.4860225Z     return helper.make_graph(
2026-11-13T10:21:49.4860850Z         [helper.make_node("Neg" if negate else "Identity", [capture], [name + "_out"])],
2026-11-13T10:21:49.4861517Z         name,
2026-11-13T10:21:49.4861814Z         [],
2026-11-13T10:21:49.4862136Z         [float_info(name + "_out")],
2026-11-13T10:21:49.4862542Z     )
2026-11-13T10:21:49.4862708Z 
2026-11-13T10:21:49.4862714Z 
2026-11-13T10:21:49.4862859Z def run_cpu(model, feeds):
2026-11-13T10:21:49.4863262Z     onnx.checker.check_model(model)
2026-11-13T10:21:49.4863713Z     options = ort.SessionOptions()
2026-11-13T10:21:49.4864400Z     options.graph_optimization_level = ort.GraphOptimizationLevel.ORT_DISABLE_ALL
2026-11-13T10:21:49.4865601Z     session = ort.InferenceSession(model.SerializeToString(), sess_options=options, providers=["CPUExecutionProvider"])
2026-11-13T10:21:49.4866586Z     return session.run(None, feeds)[0]
2026-11-13T10:21:49.4866913Z 
2026-11-13T10:21:49.4866919Z 
2026-11-13T10:21:49.4867097Z def captured_if_model(nested=False):
2026-11-13T10:21:49.4867754Z     bias = numpy_helper.from_array(np.array([2.0, -3.0], dtype=np.float32), "bias")
2026-11-13T10:21:49.4868651Z     producer = helper.make_node("Add", ["x", "bias"], ["captured"], name="producer")
2026-11-13T10:21:49.4869485Z     if nested:
2026-11-13T10:21:49.4869831Z         inner = helper.make_node(
2026-11-13T10:21:49.4870224Z             "If",
2026-11-13T10:21:49.4870615Z             ["inner_condition"],
2026-11-13T10:21:49.4871010Z             ["inner_out"],
2026-11-13T10:21:49.4871485Z             then_branch=captured_branch("deep_then", "captured"),
2026-11-13T10:21:49.4872170Z             else_branch=captured_branch("deep_else", "captured", True),
2026-11-13T10:21:49.4872733Z         )
2026-11-13T10:21:49.4873302Z         then_branch = helper.make_graph([inner], "nested_then", [], [float_info("inner_out")])
2026-11-13T10:21:49.4874012Z     else:
2026-11-13T10:21:49.4874390Z         then_branch = captured_branch("then", "captured")
2026-11-13T10:21:49.4875101Z     choice = helper.make_node(
2026-11-13T10:21:49.4875482Z         "If",
2026-11-13T10:21:49.4875794Z         ["condition"],
2026-11-13T10:21:49.4876131Z         ["output"],
2026-11-13T10:21:49.4876456Z         name="choice",
2026-11-13T10:21:49.4876817Z         then_branch=then_branch,
2026-11-13T10:21:49.4877319Z         else_branch=captured_branch("else", "captured", True),
2026-11-13T10:21:49.4877841Z     )
2026-11-13T10:21:49.4878310Z     inputs = [float_info("x"), scalar_info("condition", TensorProto.BOOL)]
2026-11-13T10:21:49.4879090Z     if nested:
2026-11-13T10:21:49.4879583Z         inputs.append(scalar_info("inner_condition", TensorProto.BOOL))
2026-11-13T10:21:49.4880423Z     return make_model([producer, choice], inputs, [float_info("output")], [bias])
2026-11-13T10:21:49.4880959Z 
2026-11-13T10:21:49.4880966Z 
2026-11-13T10:21:49.4881259Z class TestCapturedSubgraphDependencies(unittest.TestCase):
2026-11-13T10:21:49.4881914Z     def test_sort_preserves_a_valid_if_capture(self):
2026-11-13T10:21:49.4882448Z         for condition in (False, True):
2026-11-13T10:21:49.4882937Z             with self.subTest(condition=condition):
2026-11-13T10:21:49.4883446Z                 model = captured_if_model()
2026-11-13T10:21:49.4884316Z                 feeds = {"x": np.array([5.0, 7.0], dtype=np.float32), "condition": np.array(condition)}
2026-11-13T10:21:49.4885250Z                 expected = np.array([7.0, 4.0], dtype=np.float32) * (1 if condition else -1)
2026-11-13T10:21:49.4886078Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T10:21:49.4886721Z                 wrapped = ONNXModel(model)
2026-11-13T10:21:49.4887197Z                 wrapped.topological_sort()
2026-11-13T10:21:49.4887934Z                 self.assertEqual([node.name for node in model.graph.node], ["producer", "choice"])
2026-11-13T10:21:49.4889035Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T10:21:49.4890003Z 
2026-11-13T10:21:49.4890214Z     def test_sort_and_save_nested_captures(self):
2026-11-13T10:21:49.4890797Z         for outer, inner in ((True, True), (True, False), (False, True)):
2026-11-13T10:21:49.4891199Z             with self.subTest(outer=outer, inner=inner), tempfile.TemporaryDirectory() as directory:
2026-11-13T10:21:49.4891369Z                 model = captured_if_model(nested=True)
2026-11-13T10:21:49.4891621Z                 original_subgraph = model.graph.node[1].SerializeToString()
2026-11-13T10:21:49.4891798Z                 nodes = list(reversed(model.graph.node))
2026-11-13T10:21:49.4891945Z                 model.graph.ClearField("node")
2026-11-13T10:21:49.4892092Z                 model.graph.node.extend(nodes)
2026-11-13T10:21:49.4892282Z                 destination = Path(directory) / "sorted.onnx"
2026-11-13T10:21:49.4892471Z                 ONNXModel(model).save_model_to_file(destination)
2026-11-13T10:21:49.4892609Z                 saved = onnx.load(destination)
2026-11-13T10:21:49.4892956Z                 self.assertEqual(saved.graph.node[-1].SerializeToString(), original_subgraph)
2026-11-13T10:21:49.4893280Z                 expected = np.array([7.0, 4.0], dtype=np.float32) * (1 if outer and inner else -1)
2026-11-13T10:21:49.4893422Z                 np.testing.assert_array_equal(
2026-11-13T10:21:49.4893546Z                     run_cpu(
2026-11-13T10:21:49.4893664Z                         saved,
2026-11-13T10:21:49.4893775Z                         {
2026-11-13T10:21:49.4893966Z                             "x": np.array([5.0, 7.0], dtype=np.float32),
2026-11-13T10:21:49.4894120Z                             "condition": np.array(outer),
2026-11-13T10:21:49.4894288Z                             "inner_condition": np.array(inner),
2026-11-13T10:21:49.4894396Z                         },
2026-11-13T10:21:49.4894507Z                     ),
2026-11-13T10:21:49.4894626Z                     expected,
2026-11-13T10:21:49.4894726Z                 )
2026-11-13T10:21:49.4894734Z 
2026-11-13T10:21:49.4895240Z     def test_loop_body_capture_waits_for_its_producer(self):
2026-11-13T10:21:49.4895371Z         body = helper.make_graph(
2026-11-13T10:21:49.4895479Z             [
2026-11-13T10:21:49.4895754Z                 helper.make_node("Identity", ["body_condition"], ["next_condition"]),
2026-11-13T10:21:49.4896008Z                 helper.make_node("Add", ["state", "captured"], ["next_state"]),
2026-11-13T10:21:49.4896114Z             ],
2026-11-13T10:21:49.4896217Z             "body",
2026-11-13T10:21:49.4896322Z             [
2026-11-13T10:21:49.4896498Z                 scalar_info("iteration", TensorProto.INT64),
2026-11-13T10:21:49.4896691Z                 scalar_info("body_condition", TensorProto.BOOL),
2026-11-13T10:21:49.4896812Z                 float_info("state"),
2026-11-13T10:21:49.4896916Z             ],
2026-11-13T10:21:49.4897275Z             [scalar_info("next_condition", TensorProto.BOOL), float_info("next_state")],
2026-11-13T10:21:49.4897410Z         )
2026-11-13T10:21:49.4897729Z         producer = helper.make_node("Add", ["x", "bias"], ["captured"], name="producer")
2026-11-13T10:21:49.4898159Z         loop = helper.make_node("Loop", ["trip_count", "loop_condition", "x"], ["output"], name="loop", body=body)
2026-11-13T10:21:49.4898286Z         model = make_model(
2026-11-13T10:21:49.4898547Z             [loop, producer],
2026-11-13T10:21:49.4898675Z             [float_info("x")],
2026-11-13T10:21:49.4898967Z             [float_info("output")],
2026-11-13T10:21:49.4899160Z             [
2026-11-13T10:21:49.4899496Z                 numpy_helper.from_array(np.array([2.0, -3.0], dtype=np.float32), "bias"),
2026-11-13T10:21:49.4899773Z                 numpy_helper.from_array(np.array(2, dtype=np.int64), "trip_count"),
2026-11-13T10:21:49.4900017Z                 numpy_helper.from_array(np.array(True), "loop_condition"),
2026-11-13T10:21:49.4900121Z             ],
2026-11-13T10:21:49.4900230Z         )
2026-11-13T10:21:49.4900383Z         ONNXModel(model).topological_sort()
2026-11-13T10:21:49.4900712Z         self.assertEqual([node.name for node in model.graph.node], ["producer", "loop"])
2026-11-13T10:21:49.4900858Z         np.testing.assert_array_equal(
2026-11-13T10:21:49.4901083Z             run_cpu(model, {"x": np.array([5.0, 7.0], dtype=np.float32)}),
2026-11-13T10:21:49.4901254Z             np.array([19.0, 15.0], dtype=np.float32),
2026-11-13T10:21:49.4901357Z         )
2026-11-13T10:21:49.4901369Z 
2026-11-13T10:21:49.4901608Z     def test_if_sparse_initializer_capture_can_sort_and_save(self):
