2026-11-13T10:21:49.4915070Z     def test_cleanup_keeps_captured_constant_and_initializer(self):
2026-11-13T10:21:49.4915179Z         for condition in (False, True):
2026-11-13T10:21:49.4915293Z             with self.subTest(condition=condition):
2026-11-13T10:21:49.4915396Z                 branch = helper.make_graph(
2026-11-13T10:21:49.4915770Z                     [helper.make_node("Add", ["captured_constant", "captured_weight"], ["branch_output"])],
2026-11-13T10:21:49.4915865Z                     "branch",
2026-11-13T10:21:49.4915944Z                     [],
2026-11-13T10:21:49.4916057Z                     [float_info("branch_output")],
2026-11-13T10:21:49.4916136Z                 )
2026-11-13T10:21:49.4916236Z                 constant = helper.make_node(
2026-11-13T10:21:49.4916326Z                     "Constant",
2026-11-13T10:21:49.4916402Z                     [],
2026-11-13T10:21:49.4916501Z                     ["captured_constant"],
2026-11-13T10:21:49.4916588Z                     name="constant",
2026-11-13T10:21:49.4916816Z                     value=numpy_helper.from_array(np.array([3.0, -4.0], dtype=np.float32)),
2026-11-13T10:21:49.4916900Z                 )
2026-11-13T10:21:49.4917176Z                 unused = helper.make_node("Constant", [], ["unused_constant"], name="unused", value_float=99.0)
2026-11-13T10:21:49.4917276Z                 choice = helper.make_node(
2026-11-13T10:21:49.4917520Z                     "If", ["condition"], ["output"], name="choice", then_branch=branch, else_branch=branch
2026-11-13T10:21:49.4917600Z                 )
2026-11-13T10:21:49.4917690Z                 model = make_model(
2026-11-13T10:21:49.4917801Z                     [constant, unused, choice],
2026-11-13T10:21:49.4917944Z                     [scalar_info("condition", TensorProto.BOOL)],
2026-11-13T10:21:49.4918039Z                     [float_info("output")],
2026-11-13T10:21:49.4918126Z                     [
2026-11-13T10:21:49.4918379Z                         numpy_helper.from_array(np.array([7.0, 2.0], dtype=np.float32), "captured_weight"),
2026-11-13T10:21:49.4918625Z                         numpy_helper.from_array(np.array([99.0, 99.0], dtype=np.float32), "unused_weight"),
2026-11-13T10:21:49.4918706Z                     ],
2026-11-13T10:21:49.4918785Z                 )
2026-11-13T10:21:49.4919038Z                 wrapped = ONNXModel(model)
2026-11-13T10:21:49.4919152Z                 wrapped.remove_unused_constant()
2026-11-13T10:21:49.4919410Z                 self.assertEqual([node.name for node in model.graph.node], ["constant", "choice"])
2026-11-13T10:21:49.4919680Z                 self.assertEqual([value.name for value in model.graph.initializer], ["captured_weight"])
2026-11-13T10:21:49.4919786Z                 wrapped.topological_sort()
2026-11-13T10:21:49.4919896Z                 np.testing.assert_array_equal(
2026-11-13T10:21:49.4920164Z                     run_cpu(model, {"condition": np.array(condition)}), np.array([10.0, -2.0], dtype=np.float32)
2026-11-13T10:21:49.4920241Z                 )
