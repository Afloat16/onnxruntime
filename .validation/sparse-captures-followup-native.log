2026-11-13T10:21:49.4913168Z                 expected = np.array([5.0, 7.0 - 3.0 * trip_count], dtype=np.float32)
2026-11-13T10:21:49.4913350Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T10:21:49.4913582Z                 wrapped = ONNXModel(model)
2026-11-13T10:21:49.4913682Z                 wrapped.topological_sort()
2026-11-13T10:21:49.4913862Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T10:21:49.4914012Z                 output_path = Path(directory) / "sparse_loop.onnx"
2026-11-13T10:21:49.4914137Z                 wrapped.save_model_to_file(output_path)
2026-11-13T10:21:49.4914244Z                 saved = onnx.load(output_path)
2026-11-13T10:21:49.4914390Z                 self.assertEqual(len(saved.graph.initializer), 0)
2026-11-13T10:21:49.4914716Z                 self.assertEqual([value.values.name for value in saved.graph.sparse_initializer], ["sparse_capture"])
2026-11-13T10:21:49.4914886Z                 np.testing.assert_array_equal(run_cpu(saved, feeds), expected)
