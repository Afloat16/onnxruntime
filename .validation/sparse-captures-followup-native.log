2026-11-13T10:21:49.4920575Z     def test_subgraph_local_names_do_not_keep_unused_outer_initializers(self):
2026-11-13T10:21:49.4920951Z         local = numpy_helper.from_array(np.array([3.0, 4.0], dtype=np.float32), "local")
2026-11-13T10:21:49.4921049Z         branch = helper.make_graph(
2026-11-13T10:21:49.4921223Z             [helper.make_node("Identity", ["local"], ["branch_output"])],
