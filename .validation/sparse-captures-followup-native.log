2026-11-13T10:21:49.4534283Z                     requesting_tensor_names.update(sub_requesting_tensor_names)
2026-11-13T10:21:49.4534703Z                 elif attr.type == onnx.AttributeProto.GRAPHS:
2026-11-13T10:21:49.4535034Z                     cleaned_graphes = []
2026-11-13T10:21:49.4535316Z                     for subgraph in attr.graphs:
2026-11-13T10:21:49.4535591Z                         (
2026-11-13T10:21:49.4535825Z                             cleaned_sub_graph,
2026-11-13T10:21:49.4536122Z                             sub_requesting_tensor_names,
2026-11-13T10:21:49.4536466Z                         ) = _clean_initializers_helper(subgraph, model)
2026-11-13T10:21:49.4536835Z                         cleaned_graphes.append(cleaned_sub_graph)
2026-11-13T10:21:49.4537247Z                         requesting_tensor_names.update(sub_requesting_tensor_names)
2026-11-13T10:21:49.4537664Z                     new_attribute = {attr.name: cleaned_graphes}
2026-11-13T10:21:49.4537975Z                 else:
2026-11-13T10:21:49.4538230Z                     new_attribute = attribute_to_kwarg(attr)
2026-11-13T10:21:49.4538552Z                 kwargs.update(new_attribute)
2026-11-13T10:21:49.4539375Z             new_node = onnx_helper.make_node(node.op_type, node.input, node.output, name=node.name, **kwargs)
2026-11-13T10:21:49.4539874Z         new_nodes.append(new_node)
2026-11-13T10:21:49.4540056Z 
2026-11-13T10:21:49.4540155Z     graph.ClearField("node")
2026-11-13T10:21:49.4540413Z     graph.node.extend(new_nodes)
2026-11-13T10:21:49.4540799Z 
2026-11-13T10:21:49.4541110Z     requesting_tensor_names.difference_update(output for node in graph.node for output in node.output)
2026-11-13T10:21:49.4541517Z 
2026-11-13T10:21:49.4541620Z     unused_initializer = []
2026-11-13T10:21:49.4541886Z     for initializer in graph.initializer:
2026-11-13T10:21:49.4542218Z         if initializer.name in requesting_tensor_names:
2026-11-13T10:21:49.4542572Z             requesting_tensor_names.remove(initializer.name)
2026-11-13T10:21:49.4542879Z         else:
2026-11-13T10:21:49.4543168Z             # mark it to remove, remove here directly will cause mis-behavier
2026-11-13T10:21:49.4543561Z             unused_initializer.append(initializer)
2026-11-13T10:21:49.4543772Z 
2026-11-13T10:21:49.4543933Z     name_to_input = {input.name: input for input in graph.input}
2026-11-13T10:21:49.4544295Z     for initializer in unused_initializer:
2026-11-13T10:21:49.4544593Z         graph.initializer.remove(initializer)
2026-11-13T10:21:49.4544891Z         if initializer.name in name_to_input:
2026-11-13T10:21:49.4545160Z             try:
2026-11-13T10:21:49.4545431Z                 graph.input.remove(name_to_input[initializer.name])
2026-11-13T10:21:49.4545774Z             except StopIteration:
2026-11-13T10:21:49.4546029Z                 if model.ir_version < 4:
2026-11-13T10:21:49.4546658Z                     print(f"Warning: invalid weight name {initializer.name} found in the graph (not a graph input)")
2026-11-13T10:21:49.4547074Z 
2026-11-13T10:21:49.4547303Z     requesting_tensor_names.difference_update(input.name for input in graph.input)
2026-11-13T10:21:49.4547637Z 
2026-11-13T10:21:49.4547745Z     return graph, requesting_tensor_names
2026-11-13T10:21:49.4547928Z 
2026-11-13T10:21:49.4547932Z 
2026-11-13T10:21:49.4548033Z def _get_node_input_names(node):
2026-11-13T10:21:49.4548404Z     """Include values captured from enclosing scopes by subgraph attributes."""
2026-11-13T10:21:49.4549101Z     input_names = {name for name in node.input if name}
2026-11-13T10:21:49.4549500Z     for attribute in node.attribute:
2026-11-13T10:21:49.4549818Z         if attribute.type == onnx.AttributeProto.GRAPH:
2026-11-13T10:21:49.4550144Z             graphs = [attribute.g]
2026-11-13T10:21:49.4550455Z         elif attribute.type == onnx.AttributeProto.GRAPHS:
2026-11-13T10:21:49.4550801Z             graphs = attribute.graphs
2026-11-13T10:21:49.4551051Z         else:
2026-11-13T10:21:49.4551241Z             continue
2026-11-13T10:21:49.4551452Z         for graph in graphs:
2026-11-13T10:21:49.4551740Z             local_names = {value.name for value in graph.input}
2026-11-13T10:21:49.4552198Z             local_names.update(initializer.name for initializer in graph.initializer)
2026-11-13T10:21:49.4552790Z             local_names.update(initializer.values.name for initializer in graph.sparse_initializer)
2026-11-13T10:21:49.4553433Z             local_names.update(output for subnode in graph.node for output in subnode.output if output)
2026-11-13T10:21:49.4553956Z             required_names = {value.name for value in graph.output}
2026-11-13T10:21:49.4554307Z             for subnode in graph.node:
2026-11-13T10:21:49.4554636Z                 required_names.update(_get_node_input_names(subnode))
2026-11-13T10:21:49.4555020Z             input_names.update(required_names - local_names)
2026-11-13T10:21:49.4555338Z     return input_names
2026-11-13T10:21:49.4555479Z 
2026-11-13T10:21:49.4555483Z 
2026-11-13T10:21:49.4555565Z class ONNXModel:
