2026-11-13T10:21:49.4929215Z     def test_missing_capture_and_capture_cycle_are_rejected(self):
2026-11-13T10:21:49.4929329Z         for cyclic in (False, True):
2026-11-13T10:21:49.4929438Z             with self.subTest(cyclic=cyclic):
2026-11-13T10:21:49.4929544Z                 model = captured_if_model()
2026-11-13T10:21:49.4929653Z                 producer = model.graph.node[0]
2026-11-13T10:21:49.4929741Z                 if cyclic:
2026-11-13T10:21:49.4929849Z                     producer.input[0] = "output"
2026-11-13T10:21:49.4929936Z                 else:
2026-11-13T10:21:49.4930048Z                     producer.output[0] = "different"
2026-11-13T10:21:49.4930227Z                 with self.assertRaisesRegex(AssertionError, "not a DAG"):
2026-11-13T10:21:49.4930349Z                     ONNXModel(model).topological_sort()
