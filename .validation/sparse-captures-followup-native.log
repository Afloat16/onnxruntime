2026-11-13T10:21:49.4923779Z     def test_graphs_attribute_captures_all_branch_dependencies(self):
2026-11-13T10:21:49.4923968Z         first = helper.make_node("Identity", ["x"], ["first"], name="first")
2026-11-13T10:21:49.4924143Z         second = helper.make_node("Neg", ["x"], ["second"], name="second")
2026-11-13T10:21:49.4924238Z         container = helper.make_node(
2026-11-13T10:21:49.4924339Z             "GraphContainer",
2026-11-13T10:21:49.4924414Z             [],
2026-11-13T10:21:49.4924503Z             ["output"],
2026-11-13T10:21:49.4924587Z             domain="test",
2026-11-13T10:21:49.4924678Z             name="container",
2026-11-13T10:21:49.4924976Z             branches=[captured_branch("first_branch", "first"), captured_branch("second_branch", "second")],
2026-11-13T10:21:49.4925062Z         )
2026-11-13T10:21:49.4925518Z         model = make_model([container, second, first], [float_info("x")], [float_info("output")])
2026-11-13T10:21:49.4925696Z         ONNXModel(model).topological_sort()
2026-11-13T10:21:49.4925992Z         self.assertEqual(model.graph.node[-1].name, "container")
2026-11-13T10:21:49.4926259Z         self.assertEqual({node.name for node in model.graph.node[:-1]}, {"first", "second"})
