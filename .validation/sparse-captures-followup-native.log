2026-11-13T10:21:49.4566972Z             self.add_node(node)
2026-11-13T10:21:49.4567138Z 
2026-11-13T10:21:49.4567246Z     def add_initializer(self, tensor):
2026-11-13T10:21:49.4567610Z         if find_by_name(tensor.name, self.model.graph.initializer) is None:
2026-11-13T10:21:49.4567989Z             self._check_init(tensor)
2026-11-13T10:21:49.4568299Z             self.model.graph.initializer.extend([tensor])
2026-11-13T10:21:49.4568530Z 
2026-11-13T10:21:49.4568630Z     def get_initializer(self, name):
2026-11-13T10:21:49.4569213Z         for tensor in self.model.graph.initializer:
2026-11-13T10:21:49.4569532Z             if tensor.name == name:
2026-11-13T10:21:49.4569784Z                 return tensor
2026-11-13T10:21:49.4570010Z         return None
2026-11-13T10:21:49.4570136Z 
2026-11-13T10:21:49.4570300Z     def find_graph_input(self, input_name):
2026-11-13T10:21:49.4570608Z         for input in self.model.graph.input:
2026-11-13T10:21:49.4570897Z             if input.name == input_name:
2026-11-13T10:21:49.4571160Z                 return input
2026-11-13T10:21:49.4571380Z         return None
2026-11-13T10:21:49.4571507Z 
2026-11-13T10:21:49.4571623Z     def find_graph_output(self, output_name):
2026-11-13T10:21:49.4571934Z         for output in self.model.graph.output:
2026-11-13T10:21:49.4572224Z             if output.name == output_name:
2026-11-13T10:21:49.4572489Z                 return output
2026-11-13T10:21:49.4572710Z         return None
2026-11-13T10:21:49.4572832Z 
2026-11-13T10:21:49.4572953Z     def get_tensor_type(self, tensor_name: str):
2026-11-13T10:21:49.4573368Z         tensor_type_map = {obj.name: obj.type for obj in self.model.graph.value_info}
2026-11-13T10:21:49.4573685Z 
2026-11-13T10:21:49.4573788Z         if tensor_name in tensor_type_map:
2026-11-13T10:21:49.4574101Z             return tensor_type_map[tensor_name].tensor_type
2026-11-13T10:21:49.4574485Z 
2026-11-13T10:21:49.4574608Z         g_input = self.find_graph_input(tensor_name)
2026-11-13T10:21:49.4574891Z         if g_input:
2026-11-13T10:21:49.4575108Z             return g_input.type.tensor_type
2026-11-13T10:21:49.4575300Z 
2026-11-13T10:21:49.4575431Z         g_output = self.find_graph_output(tensor_name)
2026-11-13T10:21:49.4575718Z         if g_output:
2026-11-13T10:21:49.4575946Z             return g_output.type.tensor_type
2026-11-13T10:21:49.4576134Z 
2026-11-13T10:21:49.4576217Z         return None
2026-11-13T10:21:49.4576331Z 
2026-11-13T10:21:49.4576445Z     def get_constant_value(self, output_name):
2026-11-13T10:21:49.4576749Z         for node in self.model.graph.node:
2026-11-13T10:21:49.4577035Z             if node.op_type == "Constant":
2026-11-13T10:21:49.4577319Z                 if node.output[0] == output_name:
2026-11-13T10:21:49.4577621Z                     for attr in node.attribute:
2026-11-13T10:21:49.4577926Z                         if attr.name == "value":
2026-11-13T10:21:49.4578255Z                             return onnx_numpy_helper.to_array(attr.t)
2026-11-13T10:21:49.4578484Z 
2026-11-13T10:21:49.4578681Z         # Fallback to initializer since constant folding may have been applied.
2026-11-13T10:21:49.4579570Z         initializer = self.get_initializer(output_name)
2026-11-13T10:21:49.4579895Z         if initializer is not None:
2026-11-13T10:21:49.4580192Z             return onnx_numpy_helper.to_array(initializer)
2026-11-13T10:21:49.4580419Z 
2026-11-13T10:21:49.4580495Z         return None
2026-11-13T10:21:49.4580618Z 
2026-11-13T10:21:49.4580715Z     def get_initializer_name_set(self):
2026-11-13T10:21:49.4581147Z         return {initializer.name for initializer in self.model.graph.initializer}
2026-11-13T10:21:49.4581460Z 
2026-11-13T10:21:49.4581567Z     def remove_initializer(self, tensor):
2026-11-13T10:21:49.4581870Z         if tensor in self.model.graph.initializer:
2026-11-13T10:21:49.4582217Z             self.model.graph.initializer.remove(tensor)
2026-11-13T10:21:49.4582556Z             for input in self.model.graph.input:
2026-11-13T10:21:49.4582858Z                 if input.name == tensor.name:
2026-11-13T10:21:49.4583171Z                     self.model.graph.input.remove(input)
2026-11-13T10:21:49.4583473Z                     break
2026-11-13T10:21:49.4583616Z 
2026-11-13T10:21:49.4583744Z     def remove_initializers(self, init_to_remove):
2026-11-13T10:21:49.4584051Z         for initializer in init_to_remove:
2026-11-13T10:21:49.4584468Z             self.remove_initializer(initializer)
2026-11-13T10:21:49.4584701Z 
2026-11-13T10:21:49.4584876Z     def get_non_initializer_inputs(self):
2026-11-13T10:21:49.4585301Z         initializer_names = self.get_initializer_name_set()
2026-11-13T10:21:49.4585888Z         non_initializer_inputs = set()
2026-11-13T10:21:49.4586283Z         for input in self.model.graph.input:
2026-11-13T10:21:49.4586738Z             if input.name not in initializer_names:
2026-11-13T10:21:49.4587236Z                 non_initializer_inputs.add(input.name)
2026-11-13T10:21:49.4587650Z         return non_initializer_inputs
2026-11-13T10:21:49.4587932Z 
2026-11-13T10:21:49.4605482Z     def input_name_to_nodes(self):
2026-11-13T10:21:49.4606004Z         input_name_to_nodes = {}
2026-11-13T10:21:49.4606468Z         for node in self.model.graph.node:
2026-11-13T10:21:49.4606965Z             for input_name in node.input:
2026-11-13T10:21:49.4607517Z                 if input_name:  # Could be empty when it is optional
2026-11-13T10:21:49.4608131Z                     if input_name not in input_name_to_nodes:
2026-11-13T10:21:49.4608701Z                         input_name_to_nodes[input_name] = [node]
2026-11-13T10:21:49.4659551Z                     else:
2026-11-13T10:21:49.4660049Z                         input_name_to_nodes[input_name].append(node)
2026-11-13T10:21:49.4660615Z         return input_name_to_nodes
2026-11-13T10:21:49.4660891Z 
2026-11-13T10:21:49.4661057Z     def output_name_to_node(self):
2026-11-13T10:21:49.4661905Z         output_name_to_node = {}
2026-11-13T10:21:49.4662343Z         for node in self.model.graph.node:
2026-11-13T10:21:49.4662830Z             for output_name in node.output:
2026-11-13T10:21:49.4663399Z                 if output_name:  # Could be empty when it is optional
2026-11-13T10:21:49.4664011Z                     output_name_to_node[output_name] = node
2026-11-13T10:21:49.4664537Z         return output_name_to_node
2026-11-13T10:21:49.4664819Z 
2026-11-13T10:21:49.4665067Z     def get_children(self, node, input_name_to_nodes=None):
2026-11-13T10:21:49.4665618Z         if input_name_to_nodes is None:
2026-11-13T10:21:49.4666144Z             input_name_to_nodes = self.input_name_to_nodes()
2026-11-13T10:21:49.4666518Z 
2026-11-13T10:21:49.4666657Z         children = []
2026-11-13T10:21:49.4667040Z         for output in node.output:
2026-11-13T10:21:49.4667478Z             if output in input_name_to_nodes:
2026-11-13T10:21:49.4667983Z                 for node in input_name_to_nodes[output]:
2026-11-13T10:21:49.4668544Z                     children.append(node)  # noqa: PERF402
2026-11-13T10:21:49.4669310Z         return children
2026-11-13T10:21:49.4669557Z 
2026-11-13T10:21:49.4669799Z     def get_parents(self, node, output_name_to_node=None):
2026-11-13T10:21:49.4670638Z         if output_name_to_node is None:
2026-11-13T10:21:49.4671164Z             output_name_to_node = self.output_name_to_node()
2026-11-13T10:21:49.4671532Z 
2026-11-13T10:21:49.4671673Z         parents = []
2026-11-13T10:21:49.4672027Z         for input in node.input:
2026-11-13T10:21:49.4672454Z             if input in output_name_to_node:
2026-11-13T10:21:49.4672965Z                 parents.append(output_name_to_node[input])
2026-11-13T10:21:49.4673527Z         return parents
2026-11-13T10:21:49.4673857Z 
2026-11-13T10:21:49.4674123Z     def get_parent(self, node, idx, output_name_to_node=None):
2026-11-13T10:21:49.4674528Z         if output_name_to_node is None:
2026-11-13T10:21:49.4675070Z             output_name_to_node = self.output_name_to_node()
2026-11-13T10:21:49.4675600Z 
2026-11-13T10:21:49.4675806Z         if len(node.input) <= idx:
2026-11-13T10:21:49.4676196Z             return None
2026-11-13T10:21:49.4676349Z 
2026-11-13T10:21:49.4676445Z         input = node.input[idx]
2026-11-13T10:21:49.4676718Z         if input not in output_name_to_node:
2026-11-13T10:21:49.4677002Z             return None
2026-11-13T10:21:49.4677139Z 
2026-11-13T10:21:49.4677243Z         return output_name_to_node[input]
2026-11-13T10:21:49.4677595Z 
2026-11-13T10:21:49.4677779Z     def find_node_by_name(self, node_name, new_nodes_list, graph):
2026-11-13T10:21:49.4678207Z         """Find out if a node exists in a graph or a node is in the
2026-11-13T10:21:49.4678583Z         new set of nodes created during quantization.
2026-11-13T10:21:49.4678805Z 
2026-11-13T10:21:49.4679319Z         Returns:
2026-11-13T10:21:49.4679569Z             The node found or None.
2026-11-13T10:21:49.4679829Z         """
2026-11-13T10:21:49.4680081Z         graph_nodes_list = list(graph.node)  # deep copy
2026-11-13T10:21:49.4680425Z         graph_nodes_list.extend(new_nodes_list)
2026-11-13T10:21:49.4680757Z         node = find_by_name(node_name, graph_nodes_list)
2026-11-13T10:21:49.4681061Z         return node
2026-11-13T10:21:49.4681188Z 
2026-11-13T10:21:49.4681346Z     def get_largest_node_name_suffix(self, node_name_prefix):
2026-11-13T10:21:49.4681677Z         """
2026-11-13T10:21:49.4682054Z         Gets the largest node name (int) suffix for all node names that begin with `node_name_prefix`.
2026-11-13T10:21:49.4682614Z         Example: for nodes my_prefix_0 and my_prefix_3, this method returns 3.
2026-11-13T10:21:49.4682981Z         """
2026-11-13T10:21:49.4683192Z         suffix = -1
2026-11-13T10:21:49.4683320Z 
2026-11-13T10:21:49.4683427Z         for node in self.model.graph.node:
2026-11-13T10:21:49.4683789Z             if node.name and node.name.startswith(node_name_prefix):
2026-11-13T10:21:49.4684124Z                 try:
2026-11-13T10:21:49.4684597Z                     index = int(node.name[len(node_name_prefix) :])
2026-11-13T10:21:49.4684948Z                     suffix = max(index, suffix)
2026-11-13T10:21:49.4685236Z                 except ValueError:
2026-11-13T10:21:49.4685486Z                     continue
2026-11-13T10:21:49.4685646Z 
2026-11-13T10:21:49.4685728Z         return suffix
2026-11-13T10:21:49.4685861Z 
2026-11-13T10:21:49.4686061Z     def get_largest_initializer_name_suffix(self, initializer_name_prefix):
2026-11-13T10:21:49.4686433Z         """
2026-11-13T10:21:49.4686790Z         Gets the largest initializer name integer suffix for all initializer names that begin
2026-11-13T10:21:49.4687386Z         with `initializer_name_prefix`. This can be used to create unique initializer names.
2026-11-13T10:21:49.4687721Z 
2026-11-13T10:21:49.4687980Z         Example: for initializer names 'my_weight_0' and 'my_weight_3', this method returns 3 if
2026-11-13T10:21:49.4688564Z                  `initializer_name_prefix` is 'my_weight_'.
2026-11-13T10:21:49.4689354Z         """
2026-11-13T10:21:49.4689555Z         suffix = -1
2026-11-13T10:21:49.4689695Z 
2026-11-13T10:21:49.4689843Z         for initializer in self.model.graph.initializer:
2026-11-13T10:21:49.4690496Z             if initializer.name.startswith(initializer_name_prefix):
2026-11-13T10:21:49.4690860Z                 try:
2026-11-13T10:21:49.4691171Z                     index = int(initializer.name[len(initializer_name_prefix) :])
2026-11-13T10:21:49.4691553Z                     suffix = max(index, suffix)
2026-11-13T10:21:49.4691835Z                 except ValueError:
2026-11-13T10:21:49.4692083Z                     continue
2026-11-13T10:21:49.4692233Z 
2026-11-13T10:21:49.4692314Z         return suffix
2026-11-13T10:21:49.4692444Z 
2026-11-13T10:21:49.4692588Z     def find_nodes_by_initializer(self, graph, initializer):
2026-11-13T10:21:49.4692905Z         """
2026-11-13T10:21:49.4693198Z         Find all nodes with given initializer as an input.
2026-11-13T10:21:49.4693812Z         """
2026-11-13T10:21:49.4694218Z         nodes = []
2026-11-13T10:21:49.4694600Z         for node in graph.node:
2026-11-13T10:21:49.4695013Z             for node_input in node.input:
2026-11-13T10:21:49.4695516Z                 if node_input == initializer.name:
2026-11-13T10:21:49.4696028Z                     nodes.append(node)
2026-11-13T10:21:49.4696473Z         return nodes
2026-11-13T10:21:49.4696698Z 
2026-11-13T10:21:49.4696829Z     @staticmethod
2026-11-13T10:21:49.4697220Z     def __get_initializer(name, graph_path):
2026-11-13T10:21:49.4697808Z         for gid in range(len(graph_path) - 1, -1, -1):
2026-11-13T10:21:49.4698341Z             graph = graph_path[gid]
2026-11-13T10:21:49.4698807Z             for tensor in graph.initializer:
2026-11-13T10:21:49.4699536Z                 if tensor.name == name:
2026-11-13T10:21:49.4699987Z                     return tensor, graph
2026-11-13T10:21:49.4700422Z         return None, None
2026-11-13T10:21:49.4700666Z 
