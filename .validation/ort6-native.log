2026-11-13T09:33:12.9830048Z 
2026-11-13T09:33:12.9830146Z     @staticmethod
2026-11-13T09:33:12.9830514Z     def replace_node_output(node, old_output_name, new_output_name):
2026-11-13T09:33:12.9831134Z         assert isinstance(old_output_name, str) and isinstance(new_output_name, str)
2026-11-13T09:33:12.9831664Z         for j in range(len(node.output)):
2026-11-13T09:33:12.9832032Z             if node.output[j] == old_output_name:
2026-11-13T09:33:12.9832420Z                 node.output[j] = new_output_name
2026-11-13T09:33:12.9832672Z 
2026-11-13T09:33:12.9832920Z     def replace_output_of_all_nodes(self, old_output_name, new_output_name):
2026-11-13T09:33:12.9833427Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9834027Z             ONNXModel.replace_node_output(node, old_output_name, new_output_name)
2026-11-13T09:33:12.9834424Z 
2026-11-13T09:33:12.9834725Z     def replace_output_of_nodes(self, old_output_name, new_output_name, node_names_set):
2026-11-13T09:33:12.9835281Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9835643Z             if node.name in node_names_set:
2026-11-13T09:33:12.9836140Z                 ONNXModel.replace_node_output(node, old_output_name, new_output_name)
2026-11-13T09:33:12.9836529Z 
2026-11-13T09:33:12.9836672Z     def remove_unused_constant(self):
2026-11-13T09:33:12.9837206Z         input_names = {name for node in self.nodes() for name in _get_node_input_names(node)}
2026-11-13T09:33:12.9837637Z 
2026-11-13T09:33:12.9837750Z         # remove unused constant
2026-11-13T09:33:12.9838068Z         unused_nodes = []
2026-11-13T09:33:12.9838364Z         nodes = self.nodes()
2026-11-13T09:33:12.9838657Z         for node in nodes:
2026-11-13T09:33:12.9838932Z             if (
2026-11-13T09:33:12.9839198Z                 node.op_type == "Constant"
2026-11-13T09:33:12.9839589Z                 and not self.is_graph_output(node.output[0])
2026-11-13T09:33:12.9840012Z                 and node.output[0] not in input_names
2026-11-13T09:33:12.9840364Z             ):
2026-11-13T09:33:12.9840639Z                 unused_nodes.append(node)
2026-11-13T09:33:12.9840872Z 
2026-11-13T09:33:12.9841001Z         self.remove_nodes(unused_nodes)
2026-11-13T09:33:12.9841226Z 
2026-11-13T09:33:12.9841344Z         ununsed_weights = []
2026-11-13T09:33:12.9841801Z         for w in self.initializer():
2026-11-13T09:33:12.9842365Z             if w.name not in input_names and not self.is_graph_output(w.name):
2026-11-13T09:33:12.9842851Z                 ununsed_weights.append(w)
2026-11-13T09:33:12.9843206Z                 # Remove from graph.input
2026-11-13T09:33:12.9843580Z                 for graph_input in self.graph().input:
2026-11-13T09:33:12.9844094Z                     if graph_input.name == w.name:
2026-11-13T09:33:12.9844502Z                         self.graph().input.remove(graph_input)
2026-11-13T09:33:12.9844777Z 
2026-11-13T09:33:12.9844930Z         self.remove_initializers(ununsed_weights)
2026-11-13T09:33:12.9845188Z 
2026-11-13T09:33:12.9845329Z     def is_graph_output(self, output_name):
2026-11-13T09:33:12.9845838Z         return any(output.name == output_name for output in self.model.graph.output)
2026-11-13T09:33:12.9846244Z 
2026-11-13T09:33:12.9846409Z     def is_graph_input(self, tensor_name: str) -> bool:
2026-11-13T09:33:12.9846948Z         return any(input.name == tensor_name for input in self.model.graph.input)
2026-11-13T09:33:12.9847349Z 
2026-11-13T09:33:12.9847700Z     # TODO:use OnnxModel.graph_topological_sort(self.model.graph) from transformers.onnx_model
2026-11-13T09:33:12.9848480Z     # Currently it breaks Openvino/Linux training gpu pipeline so hold off for 1.8 release
2026-11-13T09:33:12.9849038Z     def topological_sort(self):
2026-11-13T09:33:12.9849472Z         deps_count = [0] * len(self.nodes())  # dependency count of each node
2026-11-13T09:33:12.9849959Z         deps_to_nodes = {}  # input to node indice
2026-11-13T09:33:12.9850359Z         sorted_nodes = []  # initialize sorted_nodes
2026-11-13T09:33:12.9850773Z         for node_idx, node in enumerate(self.nodes()):
2026-11-13T09:33:12.9851275Z             # CANNOT use len(node.input) directly because input can be optional
2026-11-13T09:33:12.9851794Z             input_names = _get_node_input_names(node)
2026-11-13T09:33:12.9852196Z             deps_count[node_idx] = len(input_names)
2026-11-13T09:33:12.9852688Z             if deps_count[node_idx] == 0:  # Constant doesn't depend on any inputs
2026-11-13T09:33:12.9853206Z                 sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T09:33:12.9853585Z                 continue
2026-11-13T09:33:12.9853764Z 
2026-11-13T09:33:12.9854053Z             for input_name in input_names:
2026-11-13T09:33:12.9854426Z                 if input_name not in deps_to_nodes:
2026-11-13T09:33:12.9854824Z                     deps_to_nodes[input_name] = [node_idx]
2026-11-13T09:33:12.9855195Z                 else:
2026-11-13T09:33:12.9855512Z                     deps_to_nodes[input_name].append(node_idx)
2026-11-13T09:33:12.9855790Z 
2026-11-13T09:33:12.9856018Z         initializer_names = [init.name for init in self.initializer()]
2026-11-13T09:33:12.9856610Z         graph_input_names = [input.name for input in self.model.graph.input]
2026-11-13T09:33:12.9857157Z         input_names = initializer_names + graph_input_names
2026-11-13T09:33:12.9857566Z         input_names.sort()
2026-11-13T09:33:12.9857870Z         prev_input_name = None
2026-11-13T09:33:12.9858189Z         for input_name in input_names:
2026-11-13T09:33:12.9858540Z             if prev_input_name == input_name:
2026-11-13T09:33:12.9858893Z                 continue
2026-11-13T09:33:12.9859064Z 
2026-11-13T09:33:12.9859195Z             prev_input_name = input_name
2026-11-13T09:33:12.9859546Z             if input_name in deps_to_nodes:
2026-11-13T09:33:12.9859935Z                 for node_idx in deps_to_nodes[input_name]:
2026-11-13T09:33:12.9860404Z                     deps_count[node_idx] = deps_count[node_idx] - 1
2026-11-13T09:33:12.9860826Z                     if deps_count[node_idx] == 0:
2026-11-13T09:33:12.9861242Z                         sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T09:33:12.9861537Z 
2026-11-13T09:33:12.9861634Z         start = 0
2026-11-13T09:33:12.9861895Z         end = len(sorted_nodes)
2026-11-13T09:33:12.9862247Z 
2026-11-13T09:33:12.9862368Z         while start < end:
2026-11-13T09:33:12.9862807Z             for output in sorted_nodes[start].output:
2026-11-13T09:33:12.9863201Z                 if output in deps_to_nodes:
2026-11-13T09:33:12.9863579Z                     for node_idx in deps_to_nodes[output]:
2026-11-13T09:33:12.9864188Z                         deps_count[node_idx] = deps_count[node_idx] - 1
2026-11-13T09:33:12.9864630Z                         if deps_count[node_idx] == 0:
2026-11-13T09:33:12.9865048Z                             sorted_nodes.append(self.nodes()[node_idx])
2026-11-13T09:33:12.9865452Z                             end = end + 1
2026-11-13T09:33:12.9865781Z             start = start + 1
2026-11-13T09:33:12.9865980Z 
2026-11-13T09:33:12.9866180Z         assert end == len(self.graph().node), "Graph is not a DAG"
2026-11-13T09:33:12.9866616Z         self.graph().ClearField("node")
2026-11-13T09:33:12.9866977Z         self.graph().node.extend(sorted_nodes)
2026-11-13T09:33:12.9867229Z 
2026-11-13T09:33:12.9867356Z     def clean_initializers(self):
2026-11-13T09:33:12.9867772Z         return _clean_initializers_helper(self.graph(), self.model)
2026-11-13T09:33:12.9868103Z 
2026-11-13T09:33:12.9868232Z     def _check_init(self, init, test=None):
2026-11-13T09:33:12.9868652Z         if init.data_type == onnx.TensorProto.FLOAT8E4M3FN:
2026-11-13T09:33:12.9869078Z             if init.HasField("raw_data"):
2026-11-13T09:33:12.9869424Z                 b = list(init.raw_data)
2026-11-13T09:33:12.9869768Z                 if any((i & 127) == 127 for i in b):
2026-11-13T09:33:12.9870215Z                     raise ValueError(f"Initializer {init.name!r} has nan.")
2026-11-13T09:33:12.9870643Z         return init
2026-11-13T09:33:12.9870806Z 
2026-11-13T09:33:12.9870924Z     def _check_node(self, node):
2026-11-13T09:33:12.9871223Z         """
2026-11-13T09:33:12.9871605Z         A quantization to float 8 does not use quantized bias but float 16 bias.
2026-11-13T09:33:12.9872188Z         This function checks that DequantizeLinear is not used to
2026-11-13T09:33:12.9872644Z         dequantize from float 16.
2026-11-13T09:33:12.9872950Z         """
2026-11-13T09:33:12.9873214Z         if node.op_type == "DequantizeLinear":
2026-11-13T09:33:12.9873584Z             zero_point = node.input[2]
2026-11-13T09:33:12.9874093Z             init = self.get_initializer(zero_point)
2026-11-13T09:33:12.9874476Z             dtype = init.data_type
2026-11-13T09:33:12.9874795Z             if dtype in {
2026-11-13T09:33:12.9875099Z                 onnx.TensorProto.FLOAT16,
2026-11-13T09:33:12.9875476Z                 onnx.TensorProto.FLOAT,
2026-11-13T09:33:12.9875828Z                 onnx.TensorProto.DOUBLE,
2026-11-13T09:33:12.9876179Z                 onnx.TensorProto.BFLOAT16,
2026-11-13T09:33:12.9876517Z             }:
2026-11-13T09:33:12.9877040Z                 raise RuntimeError(f"Unsupported DequantizeLinear operator, dequantization from {dtype}.")
2026-11-13T09:33:12.9877644Z         return node
2026-11-13T09:33:12.9877804Z 
