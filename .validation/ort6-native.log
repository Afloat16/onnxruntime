2026-11-13T09:33:12.9879302Z import tempfile
2026-11-13T09:33:12.9879553Z import unittest
2026-11-13T09:33:12.9879824Z from pathlib import Path
2026-11-13T09:33:12.9880005Z 
2026-11-13T09:33:12.9880115Z import numpy as np
2026-11-13T09:33:12.9880365Z import onnx
2026-11-13T09:33:12.9880656Z from onnx import TensorProto, helper, numpy_helper
2026-11-13T09:33:12.9880934Z 
2026-11-13T09:33:12.9881118Z import onnxruntime as ort
2026-11-13T09:33:12.9881506Z from onnxruntime.quantization.onnx_model import ONNXModel
2026-11-13T09:33:12.9881830Z 
2026-11-13T09:33:12.9881836Z 
2026-11-13T09:33:12.9881939Z def float_info(name):
2026-11-13T09:33:12.9882338Z     return helper.make_tensor_value_info(name, TensorProto.FLOAT, [2])
2026-11-13T09:33:12.9882886Z 
2026-11-13T09:33:12.9882891Z 
2026-11-13T09:33:12.9883014Z def scalar_info(name, dtype):
2026-11-13T09:33:12.9883505Z     return helper.make_tensor_value_info(name, dtype, [])
2026-11-13T09:33:12.9883806Z 
2026-11-13T09:33:12.9883811Z 
2026-11-13T09:33:12.9884118Z def make_model(nodes, inputs, outputs, initializers=()):
2026-11-13T09:33:12.9884736Z     graph = helper.make_graph(nodes, "captured_inputs", inputs, outputs, list(initializers))
2026-11-13T09:33:12.9885512Z     return helper.make_model(graph, opset_imports=[helper.make_opsetid("", 18)], ir_version=10)
2026-11-13T09:33:12.9885980Z 
2026-11-13T09:33:12.9885984Z 
2026-11-13T09:33:12.9886144Z def captured_branch(name, capture, negate=False):
2026-11-13T09:33:12.9886537Z     return helper.make_graph(
2026-11-13T09:33:12.9886947Z         [helper.make_node("Neg" if negate else "Identity", [capture], [name + "_out"])],
2026-11-13T09:33:12.9887376Z         name,
2026-11-13T09:33:12.9887611Z         [],
2026-11-13T09:33:12.9887862Z         [float_info(name + "_out")],
2026-11-13T09:33:12.9888173Z     )
2026-11-13T09:33:12.9888304Z 
2026-11-13T09:33:12.9888313Z 
2026-11-13T09:33:12.9888424Z def run_cpu(model, feeds):
2026-11-13T09:33:12.9888735Z     onnx.checker.check_model(model)
2026-11-13T09:33:12.9889077Z     options = ort.SessionOptions()
2026-11-13T09:33:12.9889594Z     options.graph_optimization_level = ort.GraphOptimizationLevel.ORT_DISABLE_ALL
2026-11-13T09:33:12.9890523Z     session = ort.InferenceSession(model.SerializeToString(), sess_options=options, providers=["CPUExecutionProvider"])
2026-11-13T09:33:12.9891257Z     return session.run(None, feeds)[0]
2026-11-13T09:33:12.9891490Z 
2026-11-13T09:33:12.9891495Z 
2026-11-13T09:33:12.9891619Z def captured_if_model(nested=False):
2026-11-13T09:33:12.9892115Z     bias = numpy_helper.from_array(np.array([2.0, -3.0], dtype=np.float32), "bias")
2026-11-13T09:33:12.9892781Z     producer = helper.make_node("Add", ["x", "bias"], ["captured"], name="producer")
2026-11-13T09:33:12.9893288Z     if nested:
2026-11-13T09:33:12.9893551Z         inner = helper.make_node(
2026-11-13T09:33:12.9893985Z             "If",
2026-11-13T09:33:12.9894253Z             ["inner_condition"],
2026-11-13T09:33:12.9894563Z             ["inner_out"],
2026-11-13T09:33:12.9894932Z             then_branch=captured_branch("deep_then", "captured"),
2026-11-13T09:33:12.9895451Z             else_branch=captured_branch("deep_else", "captured", True),
2026-11-13T09:33:12.9895877Z         )
2026-11-13T09:33:12.9896313Z         then_branch = helper.make_graph([inner], "nested_then", [], [float_info("inner_out")])
2026-11-13T09:33:12.9896841Z     else:
2026-11-13T09:33:12.9897143Z         then_branch = captured_branch("then", "captured")
2026-11-13T09:33:12.9897540Z     choice = helper.make_node(
2026-11-13T09:33:12.9897833Z         "If",
2026-11-13T09:33:12.9898073Z         ["condition"],
2026-11-13T09:33:12.9898333Z         ["output"],
2026-11-13T09:33:12.9898584Z         name="choice",
2026-11-13T09:33:12.9898855Z         then_branch=then_branch,
2026-11-13T09:33:12.9899248Z         else_branch=captured_branch("else", "captured", True),
2026-11-13T09:33:12.9899642Z     )
2026-11-13T09:33:12.9899998Z     inputs = [float_info("x"), scalar_info("condition", TensorProto.BOOL)]
2026-11-13T09:33:12.9900461Z     if nested:
2026-11-13T09:33:12.9900834Z         inputs.append(scalar_info("inner_condition", TensorProto.BOOL))
2026-11-13T09:33:12.9901455Z     return make_model([producer, choice], inputs, [float_info("output")], [bias])
2026-11-13T09:33:12.9901849Z 
2026-11-13T09:33:12.9901854Z 
2026-11-13T09:33:12.9902078Z class TestCapturedSubgraphDependencies(unittest.TestCase):
2026-11-13T09:33:12.9902568Z     def test_sort_preserves_a_valid_if_capture(self):
2026-11-13T09:33:12.9902966Z         for condition in (False, True):
2026-11-13T09:33:12.9903337Z             with self.subTest(condition=condition):
2026-11-13T09:33:12.9903721Z                 model = captured_if_model()
2026-11-13T09:33:12.9904389Z                 feeds = {"x": np.array([5.0, 7.0], dtype=np.float32), "condition": np.array(condition)}
2026-11-13T09:33:12.9905330Z                 expected = np.array([7.0, 4.0], dtype=np.float32) * (1 if condition else -1)
2026-11-13T09:33:12.9905964Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T09:33:12.9906446Z                 wrapped = ONNXModel(model)
2026-11-13T09:33:12.9906810Z                 wrapped.topological_sort()
2026-11-13T09:33:12.9907356Z                 self.assertEqual([node.name for node in model.graph.node], ["producer", "choice"])
2026-11-13T09:33:12.9908020Z                 np.testing.assert_array_equal(run_cpu(model, feeds), expected)
2026-11-13T09:33:12.9908386Z 
2026-11-13T09:33:12.9908539Z     def test_sort_and_save_nested_captures(self):
2026-11-13T09:33:12.9909018Z         for outer, inner in ((True, True), (True, False), (False, True)):
2026-11-13T09:33:12.9909688Z             with self.subTest(outer=outer, inner=inner), tempfile.TemporaryDirectory() as directory:
2026-11-13T09:33:12.9910302Z                 model = captured_if_model(nested=True)
2026-11-13T09:33:12.9910790Z                 original_subgraph = model.graph.node[1].SerializeToString()
2026-11-13T09:33:12.9911289Z                 nodes = list(reversed(model.graph.node))
2026-11-13T09:33:12.9911692Z                 model.graph.ClearField("node")
2026-11-13T09:33:12.9912076Z                 model.graph.node.extend(nodes)
2026-11-13T09:33:12.9912489Z                 destination = Path(directory) / "sorted.onnx"
2026-11-13T09:33:12.9912958Z                 ONNXModel(model).save_model_to_file(destination)
2026-11-13T09:33:12.9913388Z                 saved = onnx.load(destination)
2026-11-13T09:33:12.9914055Z                 self.assertEqual(saved.graph.node[-1].SerializeToString(), original_subgraph)
2026-11-13T09:33:12.9914786Z                 expected = np.array([7.0, 4.0], dtype=np.float32) * (1 if outer and inner else -1)
2026-11-13T09:33:12.9915332Z                 np.testing.assert_array_equal(
2026-11-13T09:33:12.9915686Z                     run_cpu(
2026-11-13T09:33:12.9915973Z                         saved,
2026-11-13T09:33:12.9916265Z                         {
2026-11-13T09:33:12.9916599Z                             "x": np.array([5.0, 7.0], dtype=np.float32),
2026-11-13T09:33:12.9917031Z                             "condition": np.array(outer),
2026-11-13T09:33:12.9917424Z                             "inner_condition": np.array(inner),
2026-11-13T09:33:12.9917805Z                         },
2026-11-13T09:33:12.9918080Z                     ),
2026-11-13T09:33:12.9918351Z                     expected,
2026-11-13T09:33:12.9918636Z                 )
2026-11-13T09:33:12.9918797Z 
2026-11-13T09:33:12.9918991Z     def test_loop_body_capture_waits_for_its_producer(self):
2026-11-13T09:33:12.9919422Z         body = helper.make_graph(
2026-11-13T09:33:12.9919723Z             [
2026-11-13T09:33:12.9920116Z                 helper.make_node("Identity", ["body_condition"], ["next_condition"]),
2026-11-13T09:33:12.9920726Z                 helper.make_node("Add", ["state", "captured"], ["next_state"]),
2026-11-13T09:33:12.9921169Z             ],
2026-11-13T09:33:12.9921406Z             "body",
2026-11-13T09:33:12.9921646Z             [
2026-11-13T09:33:12.9921950Z                 scalar_info("iteration", TensorProto.INT64),
2026-11-13T09:33:12.9922415Z                 scalar_info("body_condition", TensorProto.BOOL),
2026-11-13T09:33:12.9922839Z                 float_info("state"),
2026-11-13T09:33:12.9923150Z             ],
