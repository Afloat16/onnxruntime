2026-11-13T09:33:12.9655620Z 
2026-11-13T09:33:12.9655698Z     def remove_node(self, node):
2026-11-13T09:33:12.9655918Z         if node in self.model.graph.node:
2026-11-13T09:33:12.9656156Z             self.model.graph.node.remove(node)
2026-11-13T09:33:12.9656305Z 
2026-11-13T09:33:12.9656399Z     def remove_nodes(self, nodes_to_remove):
