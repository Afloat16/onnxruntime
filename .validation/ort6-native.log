2026-11-13T09:33:12.9651148Z             raise ValueError("Can add an empty list.")
2026-11-13T09:33:12.9651397Z         for init in self.initializer():
2026-11-13T09:33:12.9651613Z             self._check_init(init, "gain")
2026-11-13T09:33:12.9651822Z         for init in inits:
