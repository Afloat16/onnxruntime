2026-11-13T09:33:12.9804270Z                             "Add",
2026-11-13T09:33:12.9804666Z                             inputs=[node.output[0] + "_MatMul", node.input[2]],
2026-11-13T09:33:12.9805124Z                             outputs=node.output,
2026-11-13T09:33:12.9805571Z                             name=node.name + "_Add" if node.name else "",
2026-11-13T09:33:12.9805987Z                         )
2026-11-13T09:33:12.9806291Z                         new_nodes.append(add_node)
2026-11-13T09:33:12.9806540Z 
2026-11-13T09:33:12.9806659Z                 # unsupported
2026-11-13T09:33:12.9806945Z                 else:
2026-11-13T09:33:12.9807222Z                     new_nodes.append(node)
2026-11-13T09:33:12.9807459Z 
2026-11-13T09:33:12.9807555Z             # not GEMM
2026-11-13T09:33:12.9807814Z             else:
2026-11-13T09:33:12.9808076Z                 new_nodes.append(node)
2026-11-13T09:33:12.9808307Z 
2026-11-13T09:33:12.9808431Z         graph.ClearField("node")
2026-11-13T09:33:12.9808759Z         graph.node.extend(new_nodes)
2026-11-13T09:33:12.9809087Z         graph_path.pop()
2026-11-13T09:33:12.9809364Z         return graph
2026-11-13T09:33:12.9809526Z 
2026-11-13T09:33:12.9809660Z     def replace_gemm_with_matmul(self):
2026-11-13T09:33:12.9810001Z         tensor_names = set()
2026-11-13T09:33:12.9810302Z         graphs = [self.graph()]
2026-11-13T09:33:12.9810602Z         while graphs:
2026-11-13T09:33:12.9810876Z             graph = graphs.pop()
2026-11-13T09:33:12.9811327Z             tensor_names.update(tensor.name for tensor in graph.initializer)
2026-11-13T09:33:12.9812050Z             tensor_names.update(value.name for value in (*graph.input, *graph.output, *graph.value_info))
2026-11-13T09:33:12.9812648Z             for node in graph.node:
2026-11-13T09:33:12.9812998Z                 tensor_names.update(node.input)
2026-11-13T09:33:12.9813381Z                 tensor_names.update(node.output)
2026-11-13T09:33:12.9813754Z                 for attr in node.attribute:
2026-11-13T09:33:12.9814480Z                     if attr.type == onnx.AttributeProto.GRAPH:
2026-11-13T09:33:12.9814900Z                         graphs.append(attr.g)
2026-11-13T09:33:12.9815319Z                     elif attr.type == onnx.AttributeProto.GRAPHS:
2026-11-13T09:33:12.9815759Z                         graphs.extend(attr.graphs)
2026-11-13T09:33:12.9816124Z         graph_path = [self.graph()]
2026-11-13T09:33:12.9816455Z         transposed_sources = {}
2026-11-13T09:33:12.9816965Z         ONNXModel.__replace_gemm_with_matmul(graph_path, tensor_names, transposed_sources)
2026-11-13T09:33:12.9817523Z         return transposed_sources
2026-11-13T09:33:12.9817738Z 
2026-11-13T09:33:12.9817991Z     def save_model_to_file(self, output_path, use_external_data_format=False):
2026-11-13T09:33:12.9818468Z         """
2026-11-13T09:33:12.9818816Z         Save model to external data, which is needed for model size > 2GB
2026-11-13T09:33:12.9819252Z         """
2026-11-13T09:33:12.9819505Z         self.topological_sort()
2026-11-13T09:33:12.9819827Z         if use_external_data_format:
2026-11-13T09:33:12.9820248Z             onnx.external_data_helper.convert_model_to_external_data(
2026-11-13T09:33:12.9820870Z                 self.model,
2026-11-13T09:33:12.9821290Z                 all_tensors_to_one_file=True,
2026-11-13T09:33:12.9821687Z                 location=Path(output_path).name + ".data",
2026-11-13T09:33:12.9822079Z                 convert_attribute=True,
2026-11-13T09:33:12.9822398Z             )
2026-11-13T09:33:12.9822685Z         for init in self.model.graph.initializer:
2026-11-13T09:33:12.9823069Z             self._check_init(init, "end")
2026-11-13T09:33:12.9823450Z         onnx.save_model(self.model, output_path)
2026-11-13T09:33:12.9823703Z 
2026-11-13T09:33:12.9823808Z     @staticmethod
2026-11-13T09:33:12.9824289Z     def replace_node_input(node, old_input_name, new_input_name):
2026-11-13T09:33:12.9824886Z         assert isinstance(old_input_name, str) and isinstance(new_input_name, str)
2026-11-13T09:33:12.9825404Z         for j in range(len(node.input)):
2026-11-13T09:33:12.9825767Z             if node.input[j] == old_input_name:
2026-11-13T09:33:12.9826148Z                 node.input[j] = new_input_name
2026-11-13T09:33:12.9826398Z 
2026-11-13T09:33:12.9826636Z     def replace_input_of_all_nodes(self, old_input_name, new_input_name):
2026-11-13T09:33:12.9827145Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9827626Z             ONNXModel.replace_node_input(node, old_input_name, new_input_name)
2026-11-13T09:33:12.9827997Z 
2026-11-13T09:33:12.9828287Z     def replace_input_of_nodes(self, old_input_name, new_input_name, node_names_set):
2026-11-13T09:33:12.9828829Z         for node in self.model.graph.node:
