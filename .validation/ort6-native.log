2026-11-13T09:33:12.9658228Z     def add_initializer(self, tensor):
2026-11-13T09:33:12.9658523Z         if find_by_name(tensor.name, self.model.graph.initializer) is None:
2026-11-13T09:33:12.9658830Z             self._check_init(tensor)
2026-11-13T09:33:12.9659077Z             self.model.graph.initializer.extend([tensor])
2026-11-13T09:33:12.9659257Z 
2026-11-13T09:33:12.9659330Z     def get_initializer(self, name):
2026-11-13T09:33:12.9659563Z         for tensor in self.model.graph.initializer:
2026-11-13T09:33:12.9659804Z             if tensor.name == name:
2026-11-13T09:33:12.9660014Z                 return tensor
2026-11-13T09:33:12.9660193Z         return None
2026-11-13T09:33:12.9660286Z 
2026-11-13T09:33:12.9660379Z     def find_graph_input(self, input_name):
2026-11-13T09:33:12.9660613Z         for input in self.model.graph.input:
2026-11-13T09:33:12.9660838Z             if input.name == input_name:
2026-11-13T09:33:12.9661050Z                 return input
2026-11-13T09:33:12.9661231Z         return None
2026-11-13T09:33:12.9661332Z 
2026-11-13T09:33:12.9661423Z     def find_graph_output(self, output_name):
2026-11-13T09:33:12.9661664Z         for output in self.model.graph.output:
2026-11-13T09:33:12.9661900Z             if output.name == output_name:
2026-11-13T09:33:12.9662109Z                 return output
2026-11-13T09:33:12.9662289Z         return None
2026-11-13T09:33:12.9662379Z 
2026-11-13T09:33:12.9662479Z     def get_tensor_type(self, tensor_name: str):
2026-11-13T09:33:12.9662811Z         tensor_type_map = {obj.name: obj.type for obj in self.model.graph.value_info}
2026-11-13T09:33:12.9663056Z 
2026-11-13T09:33:12.9663139Z         if tensor_name in tensor_type_map:
2026-11-13T09:33:12.9663381Z             return tensor_type_map[tensor_name].tensor_type
2026-11-13T09:33:12.9663564Z 
2026-11-13T09:33:12.9663662Z         g_input = self.find_graph_input(tensor_name)
2026-11-13T09:33:12.9664088Z         if g_input:
2026-11-13T09:33:12.9664278Z             return g_input.type.tensor_type
2026-11-13T09:33:12.9664426Z 
2026-11-13T09:33:12.9664539Z         g_output = self.find_graph_output(tensor_name)
2026-11-13T09:33:12.9664806Z         if g_output:
2026-11-13T09:33:12.9664991Z             return g_output.type.tensor_type
2026-11-13T09:33:12.9665143Z 
2026-11-13T09:33:12.9665206Z         return None
2026-11-13T09:33:12.9665302Z 
2026-11-13T09:33:12.9665391Z     def get_constant_value(self, output_name):
2026-11-13T09:33:12.9665629Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9665856Z             if node.op_type == "Constant":
2026-11-13T09:33:12.9666077Z                 if node.output[0] == output_name:
2026-11-13T09:33:12.9666315Z                     for attr in node.attribute:
2026-11-13T09:33:12.9666545Z                         if attr.name == "value":
2026-11-13T09:33:12.9666799Z                             return onnx_numpy_helper.to_array(attr.t)
2026-11-13T09:33:12.9666980Z 
2026-11-13T09:33:12.9667248Z         # Fallback to initializer since constant folding may have been applied.
2026-11-13T09:33:12.9667677Z         initializer = self.get_initializer(output_name)
2026-11-13T09:33:12.9667930Z         if initializer is not None:
2026-11-13T09:33:12.9668175Z             return onnx_numpy_helper.to_array(initializer)
2026-11-13T09:33:12.9668356Z 
2026-11-13T09:33:12.9668427Z         return None
2026-11-13T09:33:12.9668517Z 
2026-11-13T09:33:12.9668606Z     def get_initializer_name_set(self):
2026-11-13T09:33:12.9668916Z         return {initializer.name for initializer in self.model.graph.initializer}
2026-11-13T09:33:12.9669151Z 
2026-11-13T09:33:12.9669241Z     def remove_initializer(self, tensor):
2026-11-13T09:33:12.9669479Z         if tensor in self.model.graph.initializer:
2026-11-13T09:33:12.9669743Z             self.model.graph.initializer.remove(tensor)
2026-11-13T09:33:12.9669997Z             for input in self.model.graph.input:
2026-11-13T09:33:12.9670241Z                 if input.name == tensor.name:
2026-11-13T09:33:12.9670493Z                     self.model.graph.input.remove(input)
2026-11-13T09:33:12.9670727Z                     break
2026-11-13T09:33:12.9670834Z 
2026-11-13T09:33:12.9670934Z     def remove_initializers(self, init_to_remove):
2026-11-13T09:33:12.9671176Z         for initializer in init_to_remove:
2026-11-13T09:33:12.9671402Z             self.remove_initializer(initializer)
2026-11-13T09:33:12.9671557Z 
2026-11-13T09:33:12.9671639Z     def get_non_initializer_inputs(self):
2026-11-13T09:33:12.9671907Z         initializer_names = self.get_initializer_name_set()
2026-11-13T09:33:12.9672166Z         non_initializer_inputs = set()
2026-11-13T09:33:12.9672392Z         for input in self.model.graph.input:
2026-11-13T09:33:12.9672629Z             if input.name not in initializer_names:
2026-11-13T09:33:12.9672880Z                 non_initializer_inputs.add(input.name)
2026-11-13T09:33:12.9673117Z         return non_initializer_inputs
2026-11-13T09:33:12.9673250Z 
2026-11-13T09:33:12.9673345Z     def input_name_to_nodes(self):
2026-11-13T09:33:12.9673551Z         input_name_to_nodes = {}
2026-11-13T09:33:12.9673768Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9674210Z             for input_name in node.input:
2026-11-13T09:33:12.9674464Z                 if input_name:  # Could be empty when it is optional
2026-11-13T09:33:12.9674754Z                     if input_name not in input_name_to_nodes:
2026-11-13T09:33:12.9675020Z                         input_name_to_nodes[input_name] = [node]
2026-11-13T09:33:12.9675255Z                     else:
2026-11-13T09:33:12.9675468Z                         input_name_to_nodes[input_name].append(node)
2026-11-13T09:33:12.9675715Z         return input_name_to_nodes
2026-11-13T09:33:12.9675847Z 
2026-11-13T09:33:12.9675923Z     def output_name_to_node(self):
2026-11-13T09:33:12.9676120Z         output_name_to_node = {}
2026-11-13T09:33:12.9676323Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9676546Z             for output_name in node.output:
2026-11-13T09:33:12.9676818Z                 if output_name:  # Could be empty when it is optional
2026-11-13T09:33:12.9677093Z                     output_name_to_node[output_name] = node
2026-11-13T09:33:12.9677326Z         return output_name_to_node
2026-11-13T09:33:12.9677445Z 
2026-11-13T09:33:12.9677564Z     def get_children(self, node, input_name_to_nodes=None):
2026-11-13T09:33:12.9677815Z         if input_name_to_nodes is None:
2026-11-13T09:33:12.9678055Z             input_name_to_nodes = self.input_name_to_nodes()
2026-11-13T09:33:12.9678229Z 
2026-11-13T09:33:12.9678298Z         children = []
2026-11-13T09:33:12.9678479Z         for output in node.output:
2026-11-13T09:33:12.9678681Z             if output in input_name_to_nodes:
2026-11-13T09:33:12.9678996Z                 for node in input_name_to_nodes[output]:
2026-11-13T09:33:12.9679389Z                     children.append(node)  # noqa: PERF402
2026-11-13T09:33:12.9679731Z         return children
2026-11-13T09:33:12.9680029Z 
2026-11-13T09:33:12.9680197Z     def get_parents(self, node, output_name_to_node=None):
2026-11-13T09:33:12.9680678Z         if output_name_to_node is None:
2026-11-13T09:33:12.9681038Z             output_name_to_node = self.output_name_to_node()
2026-11-13T09:33:12.9681296Z 
2026-11-13T09:33:12.9681392Z         parents = []
2026-11-13T09:33:12.9681642Z         for input in node.input:
2026-11-13T09:33:12.9681937Z             if input in output_name_to_node:
2026-11-13T09:33:12.9682294Z                 parents.append(output_name_to_node[input])
2026-11-13T09:33:12.9682638Z         return parents
2026-11-13T09:33:12.9682788Z 
2026-11-13T09:33:12.9682967Z     def get_parent(self, node, idx, output_name_to_node=None):
2026-11-13T09:33:12.9683350Z         if output_name_to_node is None:
2026-11-13T09:33:12.9683688Z             output_name_to_node = self.output_name_to_node()
2026-11-13T09:33:12.9684082Z 
2026-11-13T09:33:12.9684193Z         if len(node.input) <= idx:
2026-11-13T09:33:12.9684471Z             return None
2026-11-13T09:33:12.9684632Z 
2026-11-13T09:33:12.9684731Z         input = node.input[idx]
2026-11-13T09:33:12.9685040Z         if input not in output_name_to_node:
2026-11-13T09:33:12.9685343Z             return None
2026-11-13T09:33:12.9685484Z 
2026-11-13T09:33:12.9685602Z         return output_name_to_node[input]
2026-11-13T09:33:12.9685805Z 
2026-11-13T09:33:12.9685994Z     def find_node_by_name(self, node_name, new_nodes_list, graph):
2026-11-13T09:33:12.9686449Z         """Find out if a node exists in a graph or a node is in the
2026-11-13T09:33:12.9687010Z         new set of nodes created during quantization.
2026-11-13T09:33:12.9687342Z 
2026-11-13T09:33:12.9687615Z         Returns:
2026-11-13T09:33:12.9688003Z             The node found or None.
2026-11-13T09:33:12.9688407Z         """
2026-11-13T09:33:12.9688846Z         graph_nodes_list = list(graph.node)  # deep copy
2026-11-13T09:33:12.9689354Z         graph_nodes_list.extend(new_nodes_list)
2026-11-13T09:33:12.9704567Z         node = find_by_name(node_name, graph_nodes_list)
2026-11-13T09:33:12.9704957Z         return node
2026-11-13T09:33:12.9705123Z 
2026-11-13T09:33:12.9705310Z     def get_largest_node_name_suffix(self, node_name_prefix):
2026-11-13T09:33:12.9705693Z         """
2026-11-13T09:33:12.9706136Z         Gets the largest node name (int) suffix for all node names that begin with `node_name_prefix`.
2026-11-13T09:33:12.9706784Z         Example: for nodes my_prefix_0 and my_prefix_3, this method returns 3.
2026-11-13T09:33:12.9707213Z         """
2026-11-13T09:33:12.9707455Z         suffix = -1
2026-11-13T09:33:12.9707598Z 
2026-11-13T09:33:12.9707735Z         for node in self.model.graph.node:
2026-11-13T09:33:12.9708145Z             if node.name and node.name.startswith(node_name_prefix):
2026-11-13T09:33:12.9708529Z                 try:
2026-11-13T09:33:12.9708832Z                     index = int(node.name[len(node_name_prefix) :])
2026-11-13T09:33:12.9709220Z                     suffix = max(index, suffix)
2026-11-13T09:33:12.9709553Z                 except ValueError:
2026-11-13T09:33:12.9709840Z                     continue
2026-11-13T09:33:12.9710017Z 
2026-11-13T09:33:12.9710119Z         return suffix
2026-11-13T09:33:12.9710266Z 
2026-11-13T09:33:12.9710505Z     def get_largest_initializer_name_suffix(self, initializer_name_prefix):
2026-11-13T09:33:12.9710925Z         """
2026-11-13T09:33:12.9711331Z         Gets the largest initializer name integer suffix for all initializer names that begin
2026-11-13T09:33:12.9712002Z         with `initializer_name_prefix`. This can be used to create unique initializer names.
2026-11-13T09:33:12.9712396Z 
2026-11-13T09:33:12.9712682Z         Example: for initializer names 'my_weight_0' and 'my_weight_3', this method returns 3 if
2026-11-13T09:33:12.9713221Z                  `initializer_name_prefix` is 'my_weight_'.
2026-11-13T09:33:12.9713566Z         """
2026-11-13T09:33:12.9713770Z         suffix = -1
2026-11-13T09:33:12.9714037Z 
2026-11-13T09:33:12.9714211Z         for initializer in self.model.graph.initializer:
2026-11-13T09:33:12.9714989Z             if initializer.name.startswith(initializer_name_prefix):
2026-11-13T09:33:12.9715389Z                 try:
2026-11-13T09:33:12.9715737Z                     index = int(initializer.name[len(initializer_name_prefix) :])
2026-11-13T09:33:12.9716170Z                     suffix = max(index, suffix)
2026-11-13T09:33:12.9716496Z                 except ValueError:
2026-11-13T09:33:12.9716783Z                     continue
2026-11-13T09:33:12.9716957Z 
2026-11-13T09:33:12.9717060Z         return suffix
2026-11-13T09:33:12.9717204Z 
2026-11-13T09:33:12.9717376Z     def find_nodes_by_initializer(self, graph, initializer):
2026-11-13T09:33:12.9717734Z         """
2026-11-13T09:33:12.9718011Z         Find all nodes with given initializer as an input.
2026-11-13T09:33:12.9718353Z         """
2026-11-13T09:33:12.9718557Z         nodes = []
2026-11-13T09:33:12.9718813Z         for node in graph.node:
2026-11-13T09:33:12.9719105Z             for node_input in node.input:
2026-11-13T09:33:12.9719453Z                 if node_input == initializer.name:
2026-11-13T09:33:12.9719801Z                     nodes.append(node)
