2026-11-13T09:33:12.9632146Z 
2026-11-13T09:33:12.9632283Z     unused_initializer = []
2026-11-13T09:33:12.9632632Z     for initializer in graph.initializer:
2026-11-13T09:33:12.9633061Z         if initializer.name in requesting_tensor_names:
2026-11-13T09:33:12.9633530Z             requesting_tensor_names.remove(initializer.name)
2026-11-13T09:33:12.9634089Z         else:
2026-11-13T09:33:12.9634465Z             # mark it to remove, remove here directly will cause mis-behavier
2026-11-13T09:33:12.9634966Z             unused_initializer.append(initializer)
2026-11-13T09:33:12.9635237Z 
2026-11-13T09:33:12.9635457Z     name_to_input = {input.name: input for input in graph.input}
2026-11-13T09:33:12.9635893Z     for initializer in unused_initializer:
2026-11-13T09:33:12.9636264Z         graph.initializer.remove(initializer)
2026-11-13T09:33:12.9636630Z         if initializer.name in name_to_input:
2026-11-13T09:33:12.9636959Z             try:
2026-11-13T09:33:12.9637290Z                 graph.input.remove(name_to_input[initializer.name])
2026-11-13T09:33:12.9637920Z             except StopIteration:
2026-11-13T09:33:12.9638251Z                 if model.ir_version < 4:
2026-11-13T09:33:12.9639011Z                     print(f"Warning: invalid weight name {initializer.name} found in the graph (not a graph input)")
2026-11-13T09:33:12.9639510Z 
2026-11-13T09:33:12.9639826Z     requesting_tensor_names.difference_update(input.name for input in graph.input)
2026-11-13T09:33:12.9640214Z 
2026-11-13T09:33:12.9640339Z     return graph, requesting_tensor_names
2026-11-13T09:33:12.9640539Z 
2026-11-13T09:33:12.9640552Z 
2026-11-13T09:33:12.9640666Z def _get_node_input_names(node):
2026-11-13T09:33:12.9641119Z     """Include values captured from enclosing scopes by subgraph attributes."""
2026-11-13T09:33:12.9641657Z     input_names = {name for name in node.input if name}
2026-11-13T09:33:12.9642052Z     for attribute in node.attribute:
2026-11-13T09:33:12.9642439Z         if attribute.type == onnx.AttributeProto.GRAPH:
2026-11-13T09:33:12.9642799Z             graphs = [attribute.g]
2026-11-13T09:33:12.9643159Z         elif attribute.type == onnx.AttributeProto.GRAPHS:
2026-11-13T09:33:12.9643546Z             graphs = attribute.graphs
2026-11-13T09:33:12.9643834Z         else:
2026-11-13T09:33:12.9644188Z             continue
2026-11-13T09:33:12.9644434Z         for graph in graphs:
2026-11-13T09:33:12.9644777Z             local_names = {value.name for value in graph.input}
2026-11-13T09:33:12.9645322Z             local_names.update(initializer.name for initializer in graph.initializer)
2026-11-13T09:33:12.9646013Z             local_names.update(initializer.values.name for initializer in graph.sparse_initializer)
2026-11-13T09:33:12.9646832Z             local_names.update(output for subnode in graph.node for output in subnode.output if output)
2026-11-13T09:33:12.9647492Z             required_names = {value.name for value in graph.output}
2026-11-13T09:33:12.9647921Z             for subnode in graph.node:
2026-11-13T09:33:12.9648304Z                 required_names.update(_get_node_input_names(subnode))
2026-11-13T09:33:12.9648739Z             input_names.update(required_names - local_names)
2026-11-13T09:33:12.9649042Z     return input_names
2026-11-13T09:33:12.9649156Z 
2026-11-13T09:33:12.9649160Z 
2026-11-13T09:33:12.9649225Z class ONNXModel:
2026-11-13T09:33:12.9649446Z     def __init__(self, model: ModelProto):
2026-11-13T09:33:12.9649677Z         self.model = model
2026-11-13T09:33:12.9649788Z 
2026-11-13T09:33:12.9649861Z     def nodes(self):
2026-11-13T09:33:12.9650052Z         return self.model.graph.node
2026-11-13T09:33:12.9650190Z 
2026-11-13T09:33:12.9650274Z     def initializer(self):
