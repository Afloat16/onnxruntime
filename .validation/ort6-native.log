2026-11-13T09:33:12.9924202Z         )
2026-11-13T09:33:12.9924611Z         producer = helper.make_node("Add", ["x", "bias"], ["captured"], name="producer")
2026-11-13T09:33:12.9925396Z         loop = helper.make_node("Loop", ["trip_count", "loop_condition", "x"], ["output"], name="loop", body=body)
2026-11-13T09:33:12.9926006Z         model = make_model(
2026-11-13T09:33:12.9926565Z             [loop, producer],
2026-11-13T09:33:12.9926878Z             [float_info("x")],
2026-11-13T09:33:12.9927293Z             [float_info("output")],
2026-11-13T09:33:12.9927602Z             [
2026-11-13T09:33:12.9928014Z                 numpy_helper.from_array(np.array([2.0, -3.0], dtype=np.float32), "bias"),
2026-11-13T09:33:12.9928656Z                 numpy_helper.from_array(np.array(2, dtype=np.int64), "trip_count"),
2026-11-13T09:33:12.9929238Z                 numpy_helper.from_array(np.array(True), "loop_condition"),
2026-11-13T09:33:12.9929736Z             ],
2026-11-13T09:33:12.9929968Z         )
2026-11-13T09:33:12.9930230Z         ONNXModel(model).topological_sort()
2026-11-13T09:33:12.9930781Z         self.assertEqual([node.name for node in model.graph.node], ["producer", "loop"])
2026-11-13T09:33:12.9931578Z         np.testing.assert_array_equal(
2026-11-13T09:33:12.9932013Z             run_cpu(model, {"x": np.array([5.0, 7.0], dtype=np.float32)}),
2026-11-13T09:33:12.9932488Z             np.array([19.0, 15.0], dtype=np.float32),
2026-11-13T09:33:12.9932842Z         )
2026-11-13T09:33:12.9932977Z 
