2026-11-13T09:33:12.9792338Z                                 tensor_names.update(transposed_name + s for s in initializer_suffixes)
2026-11-13T09:33:12.9793062Z                                 # Keep the original tensor and its shape metadata valid for other consumers.
2026-11-13T09:33:12.9793646Z                                 graph.initializer.append(
2026-11-13T09:33:12.9794362Z                                     onnx_numpy_helper.from_array(onnx_numpy_helper.to_array(B).T, transposed_name)
2026-11-13T09:33:12.9794933Z                                 )
2026-11-13T09:33:12.9795326Z                                 transposed_weights[inputB] = transposed_name
2026-11-13T09:33:12.9795820Z                                 transposed_sources[transposed_name] = inputB
2026-11-13T09:33:12.9796311Z                             inputB = transposed_weights[inputB]  # noqa: N806
2026-11-13T09:33:12.9796729Z                         else:
2026-11-13T09:33:12.9797069Z                             inputB += "_Transposed"  # noqa: N806
2026-11-13T09:33:12.9797503Z                             transpose_node = onnx_helper.make_node(
2026-11-13T09:33:12.9797903Z                                 "Transpose",
2026-11-13T09:33:12.9798275Z                                 inputs=[node.input[1]],
2026-11-13T09:33:12.9798653Z                                 outputs=[inputB],
2026-11-13T09:33:12.9799092Z                                 name=node.name + "_Transpose" if node.name else "",
2026-11-13T09:33:12.9799527Z                             )
2026-11-13T09:33:12.9800010Z                             new_nodes.append(transpose_node)
2026-11-13T09:33:12.9800290Z 
2026-11-13T09:33:12.9800541Z                     matmul_node = onnx_helper.make_node(
2026-11-13T09:33:12.9800911Z                         "MatMul",
2026-11-13T09:33:12.9801247Z                         inputs=[node.input[0], inputB],
2026-11-13T09:33:12.9801767Z                         outputs=[node.output[0] + ("_MatMul" if len(node.input) > 2 else "")],
2026-11-13T09:33:12.9802337Z                         name=node.name + "_MatMul" if node.name else "",
2026-11-13T09:33:12.9802743Z                     )
2026-11-13T09:33:12.9803036Z                     new_nodes.append(matmul_node)
2026-11-13T09:33:12.9803287Z 
2026-11-13T09:33:12.9803413Z                     if len(node.input) > 2:
