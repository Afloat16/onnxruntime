2026-11-13T09:33:12.9720343Z     @staticmethod
2026-11-13T09:33:12.9720605Z     def __get_initializer(name, graph_path):
2026-11-13T09:33:12.9720985Z         for gid in range(len(graph_path) - 1, -1, -1):
2026-11-13T09:33:12.9721337Z             graph = graph_path[gid]
2026-11-13T09:33:12.9721636Z             for tensor in graph.initializer:
2026-11-13T09:33:12.9721958Z                 if tensor.name == name:
2026-11-13T09:33:12.9722265Z                     return tensor, graph
2026-11-13T09:33:12.9722568Z         return None, None
2026-11-13T09:33:12.9722741Z 
2026-11-13T09:33:12.9722839Z     @staticmethod
2026-11-13T09:33:12.9723220Z     def __replace_gemm_with_matmul(graph_path, tensor_names, transposed_sources):
2026-11-13T09:33:12.9723676Z         new_nodes = []
2026-11-13T09:33:12.9770687Z         graph = graph_path[-1]
2026-11-13T09:33:12.9770993Z         transposed_weights = {}
2026-11-13T09:33:12.9771232Z         for node in graph.node:
2026-11-13T09:33:12.9771573Z             graph_attrs = [attr for attr in node.attribute if attr.type == 5 or attr.type == 10]
2026-11-13T09:33:12.9771927Z             if graph_attrs:
2026-11-13T09:33:12.9772118Z                 kwargs = {}
2026-11-13T09:33:12.9772314Z                 for attr in node.attribute:
2026-11-13T09:33:12.9772555Z                     if attr.type == 5:
2026-11-13T09:33:12.9772783Z                         graph_path.append(attr.g)
2026-11-13T09:33:12.9773006Z                         kv = {
2026-11-13T09:33:12.9773257Z                             attr.name: ONNXModel.__replace_gemm_with_matmul(
2026-11-13T09:33:12.9773574Z                                 graph_path, tensor_names, transposed_sources
2026-11-13T09:33:12.9773831Z                             )
2026-11-13T09:33:12.9774218Z                         }
2026-11-13T09:33:12.9774423Z                     elif attr.type == 10:
2026-11-13T09:33:12.9774644Z                         value = []
2026-11-13T09:33:12.9774869Z                         for subgraph in attr.graphs:
2026-11-13T09:33:12.9775343Z                             graph_path.append(subgraph)
2026-11-13T09:33:12.9775722Z                             value.extend(
2026-11-13T09:33:12.9776245Z                                 [ONNXModel.__replace_gemm_with_matmul(graph_path, tensor_names, transposed_sources)]
2026-11-13T09:33:12.9776795Z                             )
2026-11-13T09:33:12.9777126Z                         kv = {attr.name: value}
2026-11-13T09:33:12.9777453Z                     else:
2026-11-13T09:33:12.9777789Z                         kv = attribute_to_kwarg(attr)
2026-11-13T09:33:12.9778138Z                     kwargs.update(kv)
2026-11-13T09:33:12.9778536Z                 node = onnx_helper.make_node(  # noqa: PLW2901
2026-11-13T09:33:12.9779016Z                     node.op_type, node.input, node.output, name=node.name, **kwargs
2026-11-13T09:33:12.9779672Z                 )
2026-11-13T09:33:12.9779948Z 
2026-11-13T09:33:12.9780078Z             if node.op_type == "Gemm":
2026-11-13T09:33:12.9780405Z                 alpha = 1.0
2026-11-13T09:33:12.9780702Z                 beta = 1.0
2026-11-13T09:33:12.9780997Z                 transA = 0  # noqa: N806
2026-11-13T09:33:12.9781334Z                 transB = 0  # noqa: N806
2026-11-13T09:33:12.9781675Z                 for attr in node.attribute:
2026-11-13T09:33:12.9782035Z                     if attr.name == "alpha":
2026-11-13T09:33:12.9782442Z                         alpha = onnx_helper.get_attribute_value(attr)
2026-11-13T09:33:12.9782924Z                     elif attr.name == "beta":
2026-11-13T09:33:12.9783335Z                         beta = onnx_helper.get_attribute_value(attr)
2026-11-13T09:33:12.9783756Z                     elif attr.name == "transA":
2026-11-13T09:33:12.9784370Z                         transA = onnx_helper.get_attribute_value(attr)  # noqa: N806
2026-11-13T09:33:12.9784857Z                     elif attr.name == "transB":
2026-11-13T09:33:12.9785324Z                         transB = onnx_helper.get_attribute_value(attr)  # noqa: N806
2026-11-13T09:33:12.9785846Z                 if alpha == 1.0 and beta == 1.0 and transA == 0:
2026-11-13T09:33:12.9786271Z                     inputB = node.input[1]  # noqa: N806
2026-11-13T09:33:12.9786645Z                     if transB == 1:
2026-11-13T09:33:12.9787133Z                         B, _ = ONNXModel.__get_initializer(node.input[1], graph_path)  # noqa: N806
2026-11-13T09:33:12.9787647Z                         if B:
2026-11-13T09:33:12.9787987Z                             if inputB not in transposed_weights:
2026-11-13T09:33:12.9788432Z                                 transposed_name = inputB + "_Transposed"
2026-11-13T09:33:12.9788987Z                                 initializer_suffixes = ("", "_quantized", "_scale", "_zero_point")
2026-11-13T09:33:12.9789497Z                                 suffix = 0
2026-11-13T09:33:12.9790056Z                                 while any(transposed_name + s in tensor_names for s in initializer_suffixes):
2026-11-13T09:33:12.9790621Z                                     suffix += 1
