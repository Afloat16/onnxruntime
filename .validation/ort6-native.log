2026-11-13T09:33:12.9955534Z             "Constant", [], ["output_constant"], value=numpy_helper.from_array(np.array([9.0, 10.0], dtype=np.float32))
2026-11-13T09:33:12.9955901Z         )
2026-11-13T09:33:12.9956108Z         add = helper.make_node("Add", ["x", "x"], ["output"])
2026-11-13T09:33:12.9956360Z         model = make_model(
2026-11-13T09:33:12.9956559Z             [add, constant],
2026-11-13T09:33:12.9956755Z             [float_info("x")],
2026-11-13T09:33:12.9956995Z             [float_info("output"), float_info("output_constant")],
2026-11-13T09:33:12.9957243Z         )
2026-11-13T09:33:12.9957419Z         wrapped = ONNXModel(model)
2026-11-13T09:33:12.9957640Z         wrapped.remove_unused_constant()
2026-11-13T09:33:12.9957866Z         wrapped.topological_sort()
2026-11-13T09:33:12.9958216Z         np.testing.assert_array_equal(
2026-11-13T09:33:12.9958665Z             run_cpu(model, {"x": np.array([2.0, 3.0], dtype=np.float32)}), np.array([4.0, 6.0], dtype=np.float32)
2026-11-13T09:33:12.9958999Z         )
2026-11-13T09:33:12.9959262Z         self.assertEqual(sum(node.op_type == "Constant" for node in model.graph.node), 1)
